---
const path = Astro.url.pathname;
const isActive = (p: string) => (path === p || path.startsWith(p + '/') ? ' style="color:#7ddfa4"' : '');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <strong>XUANBAO</strong>
      <span>Environmental Technology</span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="/" set:html={isActive('/')}>Home</a></li>
        <li>
          <a href="/products/" set:html={isActive('/products')}>Products</a>
          <ul class="dropdown">
            <li><a href="/products/scr-denox-catalysts/">SCR DeNOx Catalysts</a></li>
            <li><a href="/products/co-removal-catalyst/">CO Oxidation Catalysts</a></li>
            <li><a href="/products/voc-catalysts/">VOC Catalysts</a></li>
            <li><a href="/products/zeolite-molecular-sieve/">Zeolite Molecular Sieves</a></li>
            <li><a href="/products/activated-carbon/">Activated Carbon</a></li>
            <li><a href="/products/heating-tubes/">Heating Components</a></li>
          </ul>
        </li>
        <li>
          <a href="/solutions/" set:html={isActive('/solutions')}>Solutions</a>
          <ul class="dropdown">
            <li><a href="/solutions/voc-catalytic-oxidation/">VOC Catalytic Oxidation</a></li>
            <li><a href="/solutions/molecular-sieve-adsorption-concentration/">Zeolite Adsorption Concentration</a></li>
            <li><a href="/solutions/scr-denox/">SCR DeNOx</a></li>
            <li><a href="/solutions/co-removal/">CO Removal</a></li>
            <li><a href="/solutions/adsorption-catalytic-combustion/">Adsorption + Catalytic Combustion</a></li>
          </ul>
        </li>
        <li><a href="/industries/" set:html={isActive('/industries')}>Industries</a></li>
        <li><a href="/case-studies/" set:html={isActive('/case-studies')}>Case Studies</a></li>
        <li>
          <a href="/about/" set:html={isActive('/about')}>About</a>
          <ul class="dropdown">
            <li><a href="/r-and-d/">R&amp;D Center</a></li>
            <li><a href="/manufacturing/">Manufacturing</a></li>
            <li><a href="/quality/">Quality &amp; Testing</a></li>
            <li><a href="/service/">Service</a></li>
          </ul>
        </li>
        <li><a href="/resources/" set:html={isActive('/resources')}>Resources</a></li>
        <li><a class="btn btn-primary" style="padding:8px 16px;font-size:.88rem" href="/contact/">Get a Quote</a></li>
      </ul>
    </nav>
  </div>
</header>
