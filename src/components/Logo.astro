---
import { SITE } from 'astrowind:config';
import { Image } from 'astro:assets';
import logoMark from '~/assets/images/logo-mark.png';
---

<span class="flex items-center gap-2 self-center whitespace-nowrap">
  <Image
    src={logoMark}
    alt="Xuanbao Environmental logo"
    width={28}
    height={28}
    class="h-7 w-7 object-contain"
  />
  <span class="text-lg md:text-base font-bold tracking-tight text-gray-900 dark:text-white leading-none">
    {SITE?.name?.replace('Environmental Technology', '')}{' '}
    <span class="block text-[9px] font-medium uppercase tracking-[0.18em] text-primary dark:text-secondary mt-0.5">
      Emission Control
    </span>
  </span>
</span>
