---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Note from '~/components/widgets/Note.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import { SITE } from 'astrowind:config';
import { products, type Product } from '~/data/products';
import { getPermalink } from '~/utils/permalinks';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const productPath = '/' + product.slug.join('/') + '/';
const url = String(SITE.site).replace(/\/$/, '') + productPath;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Products', item: SITE.site + '/products/' },
    ...(product.crumbs || []).map((c, i) => ({
      '@type': 'ListItem',
      position: i + 3,
      name: c.name,
      ...(c.href ? { item: String(SITE.site).replace(/\/$/, '') + c.href } : {}),
    })),
    { '@type': 'ListItem', position: (product.crumbs?.length || 0) + 3, name: product.name },
  ],
};

const kbBase = 'https://data.xuanbaoenvironment.com';
const kbGuides: Record<
  string,
  { label: string; href: string; articles: { title: string; href: string }[] }
> = {
  'SCR DeNOx Catalysts': {
    label: 'SCR DeNOx technical guide',
    href: `${kbBase}/scr-denox/`,
    articles: [
      { title: 'How to select an SCR catalyst', href: `${kbBase}/scr-denox/scr-catalyst-selection/` },
      { title: 'Plate vs honeycomb SCR', href: `${kbBase}/scr-denox/plate-vs-honeycomb-scr/` },
      { title: 'SCR catalyst activity testing', href: `${kbBase}/scr-denox/scr-activity-testing/` },
    ],
  },
  'VOC Catalysts': {
    label: 'VOC catalysts technical guide',
    href: `${kbBase}/voc-catalysts/`,
    articles: [
      { title: 'How to select a VOC catalyst', href: `${kbBase}/voc-catalysts/voc-catalyst-selection/` },
      { title: 'Precious vs non-precious metal', href: `${kbBase}/voc-catalysts/voc-precious-vs-non-precious/` },
      { title: 'Space velocity design', href: `${kbBase}/voc-catalysts/voc-space-velocity-design/` },
    ],
  },
  'CO Oxidation Catalysts': {
    label: 'CO oxidation technical guide',
    href: `${kbBase}/co-oxidation/`,
    articles: [
      { title: 'How to select a CO catalyst', href: `${kbBase}/co-oxidation/co-catalyst-selection/` },
      { title: 'Light-off temperature', href: `${kbBase}/co-oxidation/co-light-off-temperature/` },
      { title: 'Sintering machine CO', href: `${kbBase}/co-oxidation/co-sintering-machine/` },
      { title: 'Waste incineration CO', href: `${kbBase}/co-oxidation/co-waste-incineration/` },
    ],
  },
  'Activated Carbon': {
    label: 'Activated carbon technical guide',
    href: `${kbBase}/activated-carbon/`,
    articles: [
      { title: 'How to select activated carbon', href: `${kbBase}/activated-carbon/activated-carbon-selection/` },
      { title: 'Honeycomb vs columnar', href: `${kbBase}/activated-carbon/honeycomb-vs-columnar/` },
      { title: 'Humidity & temperature effects', href: `${kbBase}/activated-carbon/activated-carbon-humidity-temperature/` },
    ],
  },
  'Zeolite Molecular Sieves': {
    label: 'Molecular sieves technical guide',
    href: `${kbBase}/molecular-sieves/`,
    articles: [
      { title: 'Molecular sieve type selection', href: `${kbBase}/molecular-sieves/molecular-sieve-type-selection/` },
      { title: 'Zeolite concentration wheels', href: `${kbBase}/molecular-sieves/zeolite-concentration-wheel/` },
      { title: 'Zeolite vs activated carbon', href: `${kbBase}/voc-engineering/zeolite-vs-activated-carbon/` },
    ],
  },
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': url + '#product',
  name: product.name,
  description: product.metaDescription,
  brand: { '@type': 'Brand', name: 'Xuanbao Environmental' },
  manufacturer: { '@id': SITE.site + '/#organization' },
  url,
  category: product.category,
  offers: {
    '@type': 'AggregateOffer',
    url,
    priceCurrency: 'USD',
    lowPrice: '120',
    highPrice: '280',
    offerCount: '1',
    itemCondition: 'https://schema.org/NewCondition',
  },
};

const faqSchema = product.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: product.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : undefined;

const related = products.filter(
  (p) => p.category === product.category && p.slug.join('/') !== product.slug.join('/')
);

const breadcrumbItems = [
  { text: 'Home', href: '/' },
  { text: 'Products', href: '/products/' },
  ...(product.crumbs || []).map((c) => ({ text: c.name, href: c.href })),
  { text: product.name },
];
---

<Layout metadata={{ title: product.seoTitle, description: product.metaDescription, ignoreTitleTemplate: true }}>
  <StructuredData slot="head" schema={[breadcrumbSchema, productSchema, faqSchema].filter(Boolean)} />

  <Breadcrumbs bar items={breadcrumbItems} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">{product.category}</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      {product.h1}
    </h1>
    {product.model && (
      <p class="mt-3 text-muted text-center">
        Product model: <strong class="text-heading">{product.model}</strong>
      </p>
    )}
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">{product.intro}</p>
    <p class="mt-3 max-w-3xl mx-auto text-center">
      Indicative price: <strong class="text-heading">From US$120</strong> (up to US$280 depending on grade, bead
      size and order quantity), FOB in USD. Confirm the exact figure on quotation.
    </p>
  </section>

  {(product.image || product.specSheet) && (
    <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-2">
      <div class="grid gap-6 md:grid-cols-2 items-start">
        {product.image && (
          <figure class="rounded-xl border border-slate-800 bg-slate-900/40 p-2">
            <Image src={product.image} alt={product.imageAlt || product.name + ' — product photo'} class="w-full h-auto rounded-lg" width={800} />
            <figcaption class="px-2 py-2 text-sm text-muted">Product photo — Xuanbao Environmental</figcaption>
          </figure>
        )}
        {product.specSheet && (
          <figure class="rounded-xl border border-slate-800 bg-white p-2">
            <Image src={product.specSheet} alt={product.specSheetAlt || product.name + ' — specification sheet'} class="w-full h-auto rounded-lg" width={840} />
          </figure>
        )}
      </div>
    </div>
  )}

  {product.facilityImage && (
    <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-2">
      <figure class="rounded-xl border border-slate-800 bg-slate-900/40 p-2">
        <Image src={product.facilityImage} alt={product.facilityImageAlt || 'On-site production equipment at Xuanbao Environmental, Yancheng, Jiangsu'} class="w-full h-auto rounded-lg" width={1080} />
        <figcaption class="px-2 py-2 text-sm text-muted">
          On-site photo — production equipment at Xuanbao Environmental's Yancheng facility (September 2026)
        </figcaption>
      </figure>
    </div>
  )}

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-12 md:space-y-16">
    {product.overview && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Overview</h2>
        <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center" set:html={product.overview} />
      </section>
    )}

    {product.specs && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Technical Data</h2>
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40">
          <table class="w-full text-sm md:text-base" set:html={product.specs} />
        </div>
        <p class="mt-3 text-sm text-muted">
          Values shown are manufacturer specifications or typical values unless marked (*). Parameters marked (*) are
          reproduced from source documentation and may contain unit or OCR ambiguities — they are reference values
          only and must be confirmed against the current product specification before use in engineering design.
          Design values are confirmed per project after operating conditions are reviewed. Please contact us for
          current data sheets.
        </p>
      </section>
    )}

    {product.industryRefs && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">
          Industry Reference Values
        </h2>
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40">
          <table class="w-full text-sm md:text-base" set:html={product.industryRefs} />
        </div>
        <p class="mt-3 text-sm text-muted">
          Industry-typical values compiled from published datasheets of Chinese peer manufacturers
          (sources collected from public Chinese-language product pages, 2026). These are <strong>reference values for
          the product class, not Xuanbao's own specifications</strong>. Request our current datasheet for
          product-specific values; grade, bead size and modification are confirmed per project.
        </p>
      </section>
    )}

    {product.chart && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Performance Chart</h2>
        <figure class="rounded-xl border border-slate-800 bg-white p-2 max-w-4xl mx-auto">
          <Image
            src={product.chart}
            alt={product.chartAlt || product.name + ' — performance chart'}
            class="w-full h-auto rounded-lg"
            width={840}
          />
          <figcaption class="px-2 py-2 text-sm text-muted">
            Light-off and T98 temperatures for common test VOCs — values are typical figures from the company brochure
            (rounded to 5 °C) and must be confirmed against the current product specification.
          </figcaption>
        </figure>
      </section>
    )}

    {product.features && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Key Features</h2>
        <ul class="grid gap-3 sm:grid-cols-2 text-muted" set:html={product.features} />
      </section>
    )}

    {product.applications && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Typical Applications</h2>
        <ul class="grid gap-3 sm:grid-cols-2 text-muted" set:html={product.applications} />
      </section>
    )}

    {product.limitations && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Application Limits &amp; Conditions</h2>
        <div
          class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-5 text-muted leading-relaxed"
          set:html={product.limitations}
        />
      </section>
    )}

    {product.custom && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Customization</h2>
        <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center" set:html={product.custom} />
      </section>
    )}

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Data to Provide for a Quotation</h2>
      <p class="text-muted mb-4 max-w-3xl mx-auto text-center">To receive a material recommendation and quotation, please share your operating conditions:</p>
      <ul class="grid gap-3 sm:grid-cols-2 text-muted">
        <li class="flex gap-2"><Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0 text-primary" />Gas flow rate (Nm³/h) and inlet / target outlet concentration</li>
        <li class="flex gap-2"><Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0 text-primary" />Gas composition and main pollutant components</li>
        <li class="flex gap-2"><Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0 text-primary" />Operating temperature and humidity</li>
        <li class="flex gap-2"><Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0 text-primary" />SO₂ and dust concentration (where applicable)</li>
        <li class="flex gap-2"><Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0 text-primary" />Existing reactor dimensions and current catalyst / adsorbent type</li>
        <li class="flex gap-2"><Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0 text-primary" />Required service life and any special requirements</li>
      </ul>
    </section>
    {product.relatedCases && product.relatedCases.length > 0 && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Field Evidence — Case Studies</h2>
        <p class="text-muted mb-4 max-w-3xl mx-auto text-center">
          Documented field tests using this catalyst. Results are specific to the tested operating conditions and are
          not a universal performance guarantee.
        </p>
        <ul class="grid gap-3 sm:grid-cols-2 max-w-3xl mx-auto">
          {product.relatedCases.map((c) => (
            <li>
              <a
                class="flex h-full items-center gap-2 rounded-lg border border-slate-700/60 bg-slate-900/40 p-4 font-semibold text-heading transition hover:border-primary hover:text-primary"
                href={getPermalink(c.href.replace(/\/+$/, ''))}
              >
                <Icon name="tabler:file-check" class="h-5 w-5 shrink-0 text-primary" />
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Related technical documentation</h2>
      <div class="max-w-3xl mx-auto text-muted space-y-3">
        {kbGuides[product.category] && (
          <p class="text-center">
            <a class="font-semibold text-primary hover:underline" href={kbGuides[product.category].href}>
              {kbGuides[product.category].label} →
            </a>
          </p>
        )}
        {kbGuides[product.category] && (
          <ul class="grid gap-2 sm:grid-cols-2">
            {kbGuides[product.category].articles.map((a) => (
              <li>
                <a class="hover:text-primary hover:underline" href={a.href}>
                  {a.title}
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="text-center text-sm pt-2">
          Testing methodology:{" "}
          <a class="hover:text-primary hover:underline" href={`${kbBase}/testing/`}>catalyst &amp; adsorbent testing</a>
          {' · '}
          Evidence traceability:{" "}
          <a class="hover:text-primary hover:underline" href={`${kbBase}/methodology/evidence-registry/`}>evidence registry</a>
        </p>
      </div>
    </section>
  </div>

  {related.length > 0 && (
    <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10">
      <Features2
        title="Related Products"
        tagline="Same family"
        columns={related.length > 2 ? 3 : 2}
        items={related.map((p) => ({
          title: p.name,
          description: p.intro,
          icon: 'tabler:box',
          href: getPermalink('/products/' + p.slug.join('/')),
        }))}
      />
    </div>
  )}

  {product.faqs && product.faqs.length > 0 && (
    <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10">
      <FAQs
        title="Frequently Asked Questions"
        tagline="FAQ"
        items={product.faqs.map((f) => ({ title: f.q, description: f.a }))}
      />
    </div>
  )}

  <CallToAction
    actions={[{ variant: 'primary', text: 'Request a Quotation', href: '/contact/', icon: 'tabler:arrow-right' }, { variant: 'whatsapp', text: 'Chat on WhatsApp', href: 'https://wa.me/8615153588090', icon: 'tabler:brand-whatsapp', target: '_blank' }]}
  >
    <Fragment slot="title">
      Discuss <span class="text-accent">this product</span> for your gas conditions
    </Fragment>
    <Fragment slot="subtitle">
      Send us your operating conditions — we will confirm applicability and return a material recommendation.
    </Fragment>
  </CallToAction>
</Layout>
