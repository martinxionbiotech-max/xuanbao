---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { headerData, footerData } from '~/navigation';

import { SITE, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;

const organizationId = `${SITE?.site}/#organization`;
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={baseSchema} />
  <slot name="head" slot="head" />
  {
    Astro.slots.has('announcement') ? (
      <slot name="announcement" />
    ) : (
      <Announcement
        badge="Documentation"
        text="Emission control technical documentation: data.xuanbaoenvironment.com »"
        href="https://data.xuanbaoenvironment.com"
        showStars={false}
      />
    )
  }
  {Astro.slots.has('header') ? <slot name="header" /> : <Header {...headerData} isSticky />}
  <main class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
</Layout>
