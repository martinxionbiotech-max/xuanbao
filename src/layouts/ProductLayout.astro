---
import BaseLayout from './BaseLayout.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const SITE = 'https://xuanbaoenvironment.com';
const productPath = product.path || '/' + product.slug.join('/') + '/';
const url = SITE + productPath;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: SITE + '/products/' },
    ...(product.crumbs || []).map((c: { name: string; href?: string }, i: number) => ({
      '@type': 'ListItem',
      position: i + 3,
      name: c.name,
      ...(c.href ? { item: SITE + c.href } : {}),
    })),
    { '@type': 'ListItem', position: (product.crumbs?.length || 0) + 3, name: product.name },
  ],
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': url + '#product',
  name: product.name,
  description: product.metaDescription,
  image: undefined,
  brand: { '@type': 'Brand', name: 'Xuanbao Environmental' },
  manufacturer: { '@id': SITE + '/#organization' },
  url,
  category: product.category,
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
};

const faqSchema = product.faqs?.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: product.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })
  : undefined;
---

<BaseLayout
  title={product.seoTitle}
  description={product.metaDescription}
  canonical={productPath}
  ogType="product"
  schema={[JSON.stringify(breadcrumb), JSON.stringify(productSchema), faqSchema].filter(Boolean) as string[]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li class="sep">/</li>
        <li><a href="/products/">Products</a></li>
        {product.crumbs?.map((c: { name: string; href?: string }) => (
          <>
            <li class="sep">/</li>
            <li>{c.href ? <a href={c.href}>{c.name}</a> : c.name}</li>
          </>
        ))}
        <li class="sep">/</li>
        <li>{product.name}</li>
      </ol>
    </div>
  </nav>

  <section class="page-head">
    <div class="container">
      <h1>{product.h1}</h1>
      <p>{product.intro}</p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="prose-narrow">
        {product.model && (
          <p class="muted">Product model: <strong>{product.model}</strong></p>
        )}

        {product.overview && (
          <>
            <h2>Overview</h2>
            <p set:html={product.overview} />
          </>
        )}

        {product.specs && (
          <>
            <h2>Technical Data</h2>
            <div class="table-wrap">
              <table class="data" set:html={product.specs} />
            </div>
            <p class="table-note">Values shown are manufacturer specifications or typical values unless marked (*). Design values are confirmed per project after operating conditions are reviewed. Please contact us for current data sheets.</p>
          </>
        )}

        {product.features && (
          <>
            <h2>Key Features</h2>
            <ul class="checklist" set:html={product.features} />
          </>
        )}

        {product.applications && (
          <>
            <h2>Typical Applications</h2>
            <ul set:html={product.applications} />
          </>
        )}

        {product.limitations && (
          <div class="callout callout-warn">
            <strong>Application limits &amp; conditions</strong>
            <span set:html={product.limitations} />
          </div>
        )}

        {product.custom && (
          <>
            <h2>Customization</h2>
            <p set:html={product.custom} />
          </>
        )}

        <h2>Data to Provide for a Quotation</h2>
        <p>To receive a material recommendation and quotation, please share your operating conditions:</p>
        <ul>
          <li>Gas flow rate (Nm³/h) and inlet / target outlet concentration</li>
          <li>Gas composition and main pollutant components</li>
          <li>Operating temperature and humidity</li>
          <li>SO₂ and dust concentration (where applicable)</li>
          <li>Existing reactor dimensions and current catalyst / adsorbent type</li>
          <li>Required service life and any special requirements</li>
        </ul>
        <p><a class="btn btn-dark" href="/contact/">Request a Quotation</a></p>

        {product.faqs && (
          <>
            <h2>FAQ</h2>
            {product.faqs.map((f) => (
              <details class="faq">
                <summary>{f.q}</summary>
                <div class="faq-body">{f.a}</div>
              </details>
            ))}
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
