---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import aboutHeroImg from '~/assets/images/about-hero-manufacturing-workshop.webp';
import aboutEquipImg from '~/assets/images/about-equipment-extrusion-line.webp';

const metadata = {
  title: 'About Xuanbao Environmental | Activated Carbon & Industrial Materials',
  description:
    'Yancheng Xuanbao Environmental Technology Co., Ltd. develops and manufactures environmental materials and adsorption products for industrial purification and emission-control applications.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About us"
    image={{
      src: aboutHeroImg,
      alt: 'Modern catalyst and adsorbent manufacturing workshop with production machinery',
    }}
  >
    <Fragment slot="title">
      About <span class="text-accent">Xuanbao</span> Environmental Technology
    </Fragment>

    <Fragment slot="subtitle">
      Yancheng Xuanbao Environmental Technology Co., Ltd. develops and manufactures precious-metal honeycomb ceramic
      catalysts for VOC catalytic oxidation, industrial emission-control catalysts and activated carbon for gas
      treatment, purification and process applications.
    </Fragment>
  </Hero>

  <Content
    tagline="Company overview"
    title="One Platform, Multiple Material Systems"
    items={[
      {
        title: 'Industrial catalysts',
        description: 'Core product line: precious-metal honeycomb ceramic catalysts for VOC oxidation — Pt (YC-XB-A), Pt-Pd (YC-XB-B) and Ag-Cu-Mn (YC-XB-C) — plus SCR DeNOx catalysts (plate and honeycomb) and CO oxidation catalysts.',
      },
      {
        title: 'Activated carbon',
        description: 'Coconut-shell, fruit-shell and coal-based carbon in honeycomb, columnar, granular and fiber forms for gas treatment, purification and process applications.',
      },
      {
        title: 'Zeolite molecular sieves',
        description: 'Modified 5A, 13X, ZSM-5 and NaY for adsorption, drying, separation and VOC concentration.',
      },
      {
        title: 'Engineering support',
        description: 'Material selection, testing and lifecycle support built around the customer’s operating conditions.',
      },
    ]}
    image={{
      src: aboutEquipImg,
      alt: 'Honeycomb ceramic extrusion and forming production equipment in a factory',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center">Applied across industry</h3>
      Power, steel, sintering, cement, alumina, petrochemical, chemical, printing, coating, pharmaceutical,
      automotive manufacturing and waste incineration.
    </Fragment>
  </Content>

  <Features
    id="facts"
    tagline="Company facts"
    title="Verified Company Information"
    subtitle="Facts below are company-provided information. Production capacity, certifications, customers and export countries are not published until documented — capability statements are available on request with supporting documentation."
    columns={3}
    items={[
      {
        title: 'Legal name',
        description: 'Yancheng Xuanbao Environmental Technology Co., Ltd. — abbreviated Xuanbao Environmental.',
        icon: 'tabler:building',
      },
      {
        title: 'Location',
        description: 'Yancheng, Jiangsu, China.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Products',
        description: 'VOC / SCR / CO catalysts, activated carbon and zeolite molecular sieves.',
        icon: 'tabler:packages',
      },
      {
        title: 'Industries served',
        description: 'Power, steel, cement, alumina, petrochemical, chemical, coating, printing, pharmaceutical, automotive and waste incineration.',
        icon: 'tabler:world',
      },
      {
        title: 'Knowledge center',
        description: 'Technical documentation published at data.xuanbaoenvironment.com.',
        icon: 'tabler:books',
      },
      {
        title: 'Contact',
        description: 'International Sales & Technical Support — WhatsApp +86 151 6936 1313, 625534887@qq.com.',
        icon: 'tabler:phone',
      },
    ]}
  />

  <Features
    tagline="Company registration"
    title="Verified Registration Details"
    subtitle="Registered details below are sourced from People's Republic of China business registries. They describe the legal entity — not factory capacity or certifications, which are published only once documented."
    columns={3}
    items={[
      {
        title: 'Founded',
        description: 'Registered 2020-05-12.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Legal representative',
        description: '于洪玲 (Yu Hongling).',
        icon: 'tabler:user',
      },
      {
        title: 'Unified Social Credit Code',
        description: '91320902MA21FMNK33.',
        icon: 'tabler:id',
      },
      {
        title: 'Registered capital',
        description: 'RMB 2,000,000.',
        icon: 'tabler:coins',
      },
      {
        title: 'Registered office',
        description: '盐城市亭湖区环保大道198号1幢165室 — Yancheng, Jiangsu (registered office, not the production site).',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Business scope',
        description: 'Goods import/export, engineering & technical R&D, environmental consulting, water & air pollution treatment, environmental equipment sales, specialty ceramics and specialty chemicals (non-hazardous).',
        icon: 'tabler:list',
      },
      {
        title: 'Enterprise size',
        description: 'Small/micro enterprise — 1 insured employee as recorded in the registry.',
        icon: 'tabler:building',
      },
    ]}
  />

  <Features
    tagline="Company direction"
    title="Vision · Mission · Values"
    subtitle="Statements as published by the company."
    columns={3}
    items={[
      {
        title: 'Vision',
        description: 'To become a recognized high-tech environmental materials company in China and international markets.',
        icon: 'tabler:eye',
      },
      {
        title: 'Mission',
        description: 'Supplying cleaner air through reliable environmental materials and technologies.',
        icon: 'tabler:wind',
      },
      {
        title: 'Values',
        description: 'Integrity · Innovation · Teamwork · Perseverance.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Features
    tagline="Honors & recognition"
    title="Company-stated Honors"
    subtitle="Awards and credit ratings as published in company materials. These are third-party credit-rating honors — not ISO or product certifications."
    columns={3}
    items={[
      {
        title: 'AAA Contract & Credit Enterprise',
        description: 'Contract-keeping and creditworthy AAA enterprise.',
        icon: 'tabler:award',
      },
      {
        title: 'AAA Integrity Model Unit',
        description: 'Integrity-management AAA demonstration unit.',
        icon: 'tabler:award',
      },
      {
        title: 'AAA Service & Credit Enterprise',
        description: 'Service-focused, creditworthy AAA enterprise.',
        icon: 'tabler:award',
      },
      {
        title: 'AAA Quality & Credit Enterprise',
        description: 'Quality-focused, creditworthy AAA enterprise.',
        icon: 'tabler:award',
      },
      {
        title: 'AAA Corporate Credit Rating',
        description: 'Corporate credit evaluation AAA credit enterprise.',
        icon: 'tabler:award',
      },
      {
        title: 'Integrity Supplier',
        description: 'Recognized integrity supplier award.',
        icon: 'tabler:award',
      },
      {
        title: 'AAA Quality & Service Enterprise',
        description: 'Quality and service AAA integrity enterprise.',
        icon: 'tabler:award',
      },
      {
        title: 'AAA Corporate Creditworthiness',
        description: 'Corporate creditworthiness evaluation AAA credit enterprise.',
        icon: 'tabler:award',
      },
      {
        title: '2020 Outstanding Supplier',
        description: 'Outstanding Supplier of the Year 2020.',
        icon: 'tabler:award',
      },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: 'Explore Our R&D Center', href: '/r-and-d/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Technology first. <span class="text-accent">Quality oriented.</span>
    </Fragment>
  </CallToAction>
</Layout>
