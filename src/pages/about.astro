---
import BaseLayout from '../layouts/BaseLayout.astro';

const SITE = 'https://xuanbaoenvironment.com';
const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'About Us', item: SITE + '/about/' },
  ],
});
---

<BaseLayout
  title="About Xuanbao Environmental | Industrial Catalyst & Adsorbent Manufacturer"
  description="Yancheng Xuanbao Environmental Technology Co., Ltd. — manufacturer of SCR DeNOx catalysts, CO oxidation catalysts, VOC catalysts, zeolite molecular sieves and activated carbon."
  canonical="/about/"
  schema={[breadcrumb]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li class="sep">/</li>
        <li>About Us</li>
      </ol>
    </div>
  </nav>

  <section class="page-head">
    <div class="container">
      <h1>About Xuanbao Environmental Technology</h1>
      <p>An industrial emission control materials company focused on R&amp;D, manufacturing, sales, testing and technical service.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="container prose-narrow">
      <p>
        Yancheng Xuanbao Environmental Technology Co., Ltd. is a company focused on the research, development,
        production, sales, testing and technical service of industrial emission control materials.
      </p>

      <h2>What We Do</h2>
      <ul>
        <li>SCR DeNOx catalysts</li>
        <li>CO oxidation catalysts</li>
        <li>VOC oxidation catalysts</li>
        <li>Zeolite molecular sieves</li>
        <li>Activated carbon</li>
        <li>VOC adsorption-concentration materials</li>
        <li>Related emission-control material solutions</li>
      </ul>

      <h2>Industries Served</h2>
      <p>
        Our materials and technologies are applied in power, petrochemical, steel, metallurgy, cement, alumina,
        building materials, glass, ceramics, chemical, pharmaceutical, automotive manufacturing, coating, printing,
        industrial furnaces and waste incineration, among others.
      </p>

      <h2>Vision</h2>
      <p>To become a recognized high-tech environmental materials company in China and international markets.</p>

      <h2>Mission</h2>
      <p>Supplying cleaner air through reliable environmental materials and technologies.</p>

      <h2>Values</h2>
      <p><strong>Integrity · Innovation · Teamwork · Perseverance</strong></p>

      <p><a class="btn btn-dark" href="/r-and-d/">Explore Our R&amp;D Center</a></p>
    </div>
  </section>
</BaseLayout>
