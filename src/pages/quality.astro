---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Quality Assurance & Testing',
  description:
    'QA/QC procedures for catalysts and adsorbents — incoming material, process, coating, forming and final inspection, batch traceability and performance testing.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'About Us', href: '/about/' }, { text: 'Quality & Testing' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">About Us</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Quality Assurance &amp; Testing
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Quality as verifiable information — procedures, inspections and testing capabilities.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-12">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">QA / QC Procedures</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Incoming material inspection</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Process inspection</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Coating inspection</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Forming inspection</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Final product inspection</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Batch traceability</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Performance testing</li>
      </ul>
    </section>

    <Features
      columns={3}
      title="Testing Capabilities"
      items={[
        { title: 'Material Analysis', description: 'BET, XRF, XRD and ICP characterization of raw materials and finished products.', icon: 'tabler:microscope' },
        { title: 'Adsorption Testing', description: 'Dynamic adsorption testing against the target medium.', icon: 'tabler:wind' },
        { title: 'Catalyst Testing', description: 'Catalyst activity testing under simulated operating conditions.', icon: 'tabler:flask' },
        { title: 'Mechanical Testing', description: 'Compressive strength, wear and physical property testing.', icon: 'tabler:gauge' },
        { title: 'Third-Party Testing', description: 'Combined with third-party testing or customer-specified requirements.', icon: 'tabler:certificate' },
        { title: 'Documentation', description: 'Testing data and documentation provided with the product.', icon: 'tabler:file-check' },
      ]}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Data Classification</h2>
      <p class="text-muted mb-4 max-w-3xl mx-auto text-center">On product pages we distinguish data types so engineering decisions are made on the right basis:</p>
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40 p-1"><table class="w-full text-sm md:text-base"><tbody><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Manufacturer specification</td><td class="px-3 py-2 align-top text-muted">the product's defined property range.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Typical value</td><td class="px-3 py-2 align-top text-muted">laboratory or application performance under stated conditions.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Test result</td><td class="px-3 py-2 align-top text-muted">measured data from a specific test, with its conditions.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Design value</td><td class="px-3 py-2 align-top text-muted">engineering reference; actual performance depends on operating conditions.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Field data</td><td class="px-3 py-2 align-top text-muted">measured data from a specific industrial application, valid for the tested conditions and not a universal performance guarantee.</td></tr></tbody></table></div>
    </section>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'See Our Service Scope', href: '/service/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Verifiable quality, <span class="text-accent">end to end</span>
    </Fragment>
  </CallToAction>
</Layout>
