---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Quality Assurance & Testing',
  description:
    'QA/QC procedures for catalysts and adsorbents — incoming material, process, coating, forming and final inspection, batch traceability and performance testing.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'About Us', href: '/about/' }, { text: 'Quality & Testing' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">About Us</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      Quality Assurance &amp; Testing
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">
      Quality as verifiable information — procedures, inspections and testing capabilities.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-12">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">QA / QC Procedures</h2>
      <ul class="grid gap-2 sm:grid-cols-2 text-muted">
        <li>Incoming material inspection</li>
        <li>Process inspection</li>
        <li>Coating inspection</li>
        <li>Forming inspection</li>
        <li>Final product inspection</li>
        <li>Batch traceability</li>
        <li>Performance testing</li>
      </ul>
    </section>

    <Features
      columns={3}
      title="Testing Capabilities"
      items={[
        { title: 'Material Analysis', description: 'BET, XRF, XRD and ICP characterization of raw materials and finished products.', icon: 'tabler:microscope' },
        { title: 'Adsorption Testing', description: 'Dynamic adsorption testing against the target medium.', icon: 'tabler:wind' },
        { title: 'Catalyst Testing', description: 'Catalyst activity testing under simulated operating conditions.', icon: 'tabler:flask' },
        { title: 'Mechanical Testing', description: 'Compressive strength, wear and physical property testing.', icon: 'tabler:gauge' },
        { title: 'Third-Party Testing', description: 'Combined with third-party testing or customer-specified requirements.', icon: 'tabler:certificate' },
        { title: 'Documentation', description: 'Testing data and documentation provided with the product.', icon: 'tabler:file-check' },
      ]}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Data Classification</h2>
      <p class="text-muted mb-4">On product pages we distinguish data types so engineering decisions are made on the right basis:</p>
      <ul class="space-y-2 text-muted">
        <li><strong class="text-heading">Manufacturer specification</strong> — the product's defined property range.</li>
        <li><strong class="text-heading">Typical value</strong> — laboratory or application performance under stated conditions.</li>
        <li><strong class="text-heading">Test result</strong> — measured data from a specific test, with its conditions.</li>
        <li><strong class="text-heading">Design value</strong> — engineering reference; actual performance depends on operating conditions.</li>
      </ul>
    </section>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'See Our Service Scope', href: '/service/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Verifiable quality, <span class="text-accent">end to end</span>
    </Fragment>
  </CallToAction>
</Layout>
