---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Activated Carbon & Catalyst R&D | Xuanbao Environmental',
  description:
    'R&D at Xuanbao: activated carbon development and modification, SCR / CO / VOC catalyst development, BET, XRF, XRD, ICP characterization and dynamic adsorption testing.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'About Us', href: '/about/' }, { text: 'R&D' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">About Us</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Research &amp; Development
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Xuanbao’s R&amp;D activities focus on the development, modification, characterization and performance
      evaluation of activated carbon, adsorption materials and industrial catalysts.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-12">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Material Development</h2>
      <p class="text-muted mb-4 leading-relaxed max-w-3xl mx-auto text-center">
        Activated carbon and adsorption materials are developed and modified per application — the raw material,
        activation conditions, pore structure and surface chemistry are adjusted to the target contaminant and
        operating conditions rather than sold as a single catalogue product.
      </p>
      <ul class="grid gap-3 sm:grid-cols-2">
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Activated carbon formulation</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Activation process development</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Pore-structure regulation</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Modification and surface treatment</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Zeolite modification</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">VOC adsorption materials</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Thermal regeneration</li>
      </ul>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Catalyst Development</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">SCR catalyst formulation</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">CO oxidation catalyst development</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">VOC oxidation catalyst formulation</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Catalyst coating and washcoat preparation</li>
        <li class="rounded-lg border border-slate-700/60 bg-slate-900/40 p-3 text-muted">Honeycomb catalyst preparation</li>
      </ul>
    </section>

    <Features
      columns={3}
      title="Material Characterization"
      subtitle="Characterization methods used in our laboratory — capabilities as stated on this site."
      items={[
        { title: 'BET', description: 'Specific surface area and pore structure analysis of materials.', icon: 'tabler:chart-area' },
        { title: 'XRF', description: 'Elemental and composition analysis of materials.', icon: 'tabler:radar-2' },
        { title: 'XRD', description: 'Crystal phase and crystal structure analysis.', icon: 'tabler:prism' },
        { title: 'ICP', description: 'Elemental composition and metal content analysis.', icon: 'tabler:flask-2' },
        {
          title: 'Dynamic Testing',
          description: 'Dynamic simulation testing against the target gas or adsorption medium under controlled conditions.',
          icon: 'tabler:wind',
        },
        {
          title: 'Performance Evaluation',
          description: 'Adsorption capacity, catalyst activity, mechanical strength and wear resistance testing.',
          icon: 'tabler:gauge',
        },
      ]}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-6 text-center">R&amp;D Workflow</h2>
      <Steps
        items={[
          { title: 'Application requirement', description: 'Target contaminant, conditions and performance goals from the customer.' },
          { title: 'Material selection', description: 'Candidate raw materials, formulations and forms.' },
          { title: 'Formulation / modification', description: 'Adjustment of composition, activation and surface chemistry.' },
          { title: 'Laboratory characterization', description: 'BET, XRF, XRD, ICP and pore analysis of the candidate material.' },
          { title: 'Performance testing', description: 'Adsorption capacity or catalyst activity under simulated conditions.' },
          { title: 'Optimization', description: 'Iteration until the target performance is reached in the laboratory.' },
          { title: 'Pilot / field evaluation', description: 'Verification under real or representative operating conditions.' },
          { title: 'Production', description: 'Transfer to batch production with process control.' },
        ]}
      />
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Cooperation</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        The company carries out technical cooperation with universities and research institutions. Specific
        cooperation details are disclosed with formal agreements and publicly available proof.
      </p>
    </section>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'See Quality & Testing', href: '/quality/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      From development to <span class="text-accent">verified product</span>
    </Fragment>
  </CallToAction>
</Layout>
