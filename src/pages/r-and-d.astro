---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'R&D Center — Catalyst & Adsorbent Development',
  description:
    'Xuanbao R&D center: catalyst formulation, coating, honeycomb preparation, zeolite modification, adsorption evaluation and process optimization with BET, XRF, XRD, ICP and dynamic simulation testing.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'About Us', href: '/about/' }, { text: 'R&D Center' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">About Us</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      R&amp;D Center
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">Technology First. Quality Oriented.</p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-12">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">R&amp;D Directions</h2>
      <p class="text-muted mb-4 leading-relaxed">
        From the early days of the company, R&amp;D has been central to how we work. The R&amp;D center continuously
        develops, modifies, tests and optimizes catalysts and adsorption materials.
      </p>
      <ul class="grid gap-2 sm:grid-cols-2 text-muted">
        <li>Catalyst formulation</li>
        <li>Catalyst coating</li>
        <li>Honeycomb catalyst preparation</li>
        <li>SCR catalyst development</li>
        <li>CO oxidation catalyst development</li>
        <li>Zeolite modification</li>
        <li>Adsorption performance evaluation</li>
        <li>VOC adsorption materials</li>
        <li>Thermal regeneration</li>
        <li>Material characterization</li>
        <li>Process optimization</li>
      </ul>
    </section>

    <Features
      columns={3}
      title="Analytical & Testing Capabilities"
      items={[
        { title: 'BET', description: 'Specific surface area and pore structure analysis of materials.', icon: 'tabler:chart-area' },
        { title: 'XRF', description: 'Elemental and composition analysis of materials.', icon: 'tabler:radar-2' },
        { title: 'XRD', description: 'Crystal phase and crystal structure analysis.', icon: 'tabler:prism' },
        { title: 'ICP', description: 'Elemental composition and metal content analysis.', icon: 'tabler:flask-2' },
        {
          title: 'Dynamic Simulation',
          description: 'Dynamic simulation testing against the target gas or adsorption medium before batch production.',
          icon: 'tabler:wind',
        },
        {
          title: 'Performance Evaluation',
          description: 'Catalyst activity, adsorption capacity and mechanical strength testing.',
          icon: 'tabler:gauge',
        },
      ]}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Cooperation</h2>
      <p class="text-muted leading-relaxed">
        The company carries out technical cooperation with universities and research institutions. Specific
        cooperation details are disclosed with formal agreements and publicly available proof.
      </p>
    </section>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'See Quality & Testing', href: '/quality/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      From development to <span class="text-accent">verified product</span>
    </Fragment>
  </CallToAction>
</Layout>
