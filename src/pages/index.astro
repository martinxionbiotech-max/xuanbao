---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Activated Carbon & Industrial Adsorption Materials | Xuanbao Environmental',
  description:
    'Manufacturer of activated carbon, adsorption materials and industrial emission-control materials for gas treatment, water purification and industrial process applications.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Yancheng Xuanbao Environmental Technology Co., Ltd."
    actions={[
      { variant: 'primary', text: 'Explore Activated Carbon Products', href: '/products/activated-carbon/', icon: 'tabler:arrow-right' },
      { text: 'Tell Us Your Application', href: '/contact/' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516937941344-00b4e0337589?auto=format&fit=crop&w=1600&q=80',
      alt: 'Industrial gas treatment installation',
    }}
  >
    <Fragment slot="title">
      Activated Carbon &amp; <span class="text-accent">Industrial Adsorption Materials</span>
    </Fragment>

    <Fragment slot="subtitle">
      Xuanbao Environmental manufactures activated carbon, adsorption materials and industrial emission-control
      materials for gas treatment, water purification and process applications. From raw-material selection and
      material development to manufacturing, testing and technical support, we help industrial customers select
      materials according to their operating conditions and performance requirements.
    </Fragment>
  </Hero>

  <Stats
    stats={[
      { title: 'Product families', amount: '5' },
      { title: 'Product models', amount: '15' },
      { title: 'Industries served', amount: '12' },
      { title: 'Documented field tests', amount: '2' },
    ]}
  />

  <Features
    id="business-areas"
    tagline="Business areas"
    title="Materials for Different Industrial Applications"
    subtitle="Two connected directions, one material platform: activated carbon, adsorption materials and catalysts selected by application."
    columns={2}
    items={[
      {
        title: 'Environmental & Gas Treatment',
        description:
          'Activated carbon and catalytic materials for VOC adsorption, solvent vapor control, odor control, industrial waste gas treatment and gas purification — plus CO oxidation, SCR DeNOx and VOC catalytic oxidation catalysts for flue gas and exhaust streams.',
        icon: 'tabler:wind',
        callToAction: { text: 'Explore Gas Treatment Applications', href: '/industries/' },
      },
      {
        title: 'Water & Process Purification',
        description:
          'Activated carbon and adsorption materials for water treatment, wastewater polishing, decolorization, chemical purification, pharmaceutical processing, food and beverage purification and selected industrial process applications.',
        icon: 'tabler:droplet',
        callToAction: { text: 'Explore Purification Applications', href: '/products/activated-carbon/coconut-shell-carbon/' },
      },
    ]}
  />

  <Features
    id="materials"
    tagline="By raw material"
    title="Activated Carbon by Raw Material"
    subtitle="Activated carbon performance depends on raw material, activation method, pore structure, physical form and target adsorbate. We supply different carbon-material systems for different industrial requirements."
    columns={3}
    items={[
      {
        title: 'Coconut Shell Activated Carbon',
        description:
          'Commonly associated with a highly microporous structure, used where adsorption of suitable small molecules and high surface-area characteristics are required. Actual suitability depends on product grade and operating conditions.',
        icon: 'tabler:nut',
        callToAction: { text: 'View Coconut Shell Activated Carbon', href: '/products/activated-carbon/coconut-shell-carbon/' },
      },
      {
        title: 'Coal-Based Activated Carbon',
        description:
          'Produced from selected coal through carbonization and activation. Supplied in columnar form for gas purification and industrial packed-bed adsorption; selection depends on the target contaminant and operating conditions.',
        icon: 'tabler:layers-subtract',
        callToAction: { text: 'View Coal-Based Activated Carbon', href: '/products/activated-carbon/coal-based-columnar-carbon/' },
      },
      {
        title: 'Other Material Systems',
        description:
          'Additional raw-material systems — for example fruit-shell, bamboo or wood-based carbons — can be discussed for specific applications. We confirm supply and recommend the system from the application, not the other way around.',
        icon: 'tabler:packages',
        callToAction: { text: 'Discuss Material Options', href: '/contact/' },
      },
    ]}
  />

  <Features
    id="forms"
    tagline="By product form"
    title="Activated Carbon Forms"
    subtitle="Raw material and physical form are two separate dimensions of selection. Granular and powdered forms can additionally be discussed for specific applications."
    columns={3}
    items={[
      {
        title: 'Honeycomb Activated Carbon',
        description: 'For gas-treatment systems requiring low pressure drop and structured contact surfaces.',
        icon: 'tabler:hexagons',
        callToAction: { text: 'View Honeycomb Activated Carbon', href: '/products/activated-carbon/honeycomb-activated-carbon/' },
      },
      {
        title: 'Columnar Activated Carbon',
        description: 'For gas-phase adsorption and industrial packed-bed systems where applicable.',
        icon: 'tabler:columns-3',
        callToAction: { text: 'View Columnar Activated Carbon', href: '/products/activated-carbon/coal-based-columnar-carbon/' },
      },
      {
        title: 'Fiber Activated Carbon',
        description: 'For low-concentration gas-phase pollutants, odor control and combined dust filtration.',
        icon: 'tabler:line',
        callToAction: { text: 'View Activated Carbon Fiber', href: '/products/activated-carbon/activated-carbon-fiber/' },
      },
    ]}
  />

  <Steps
    id="selection"
    title="Material Selection Starts With Your Operating Conditions"
    items={[
      {
        title: 'Target material',
        description: 'Which contaminant or adsorbate must be removed or recovered — VOC, odor, CO, NOx or a specific impurity.',
        icon: 'tabler:target',
      },
      {
        title: 'Application',
        description: 'Gas treatment, water purification or a process application — each has its own contact conditions.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'Gas / liquid conditions',
        description: 'Composition, concentration, flow, temperature, humidity, pressure, dust, pH and existing equipment.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Adsorption requirements',
        description: 'Target outlet concentration, contact time, pressure drop budget and required service life.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Material selection',
        description: 'Raw material, pore structure, form and modification are proposed from the conditions above.',
        icon: 'tabler:selector',
      },
      {
        title: 'Laboratory / dynamic testing',
        description: 'Where applicable, materials are tested against the target gas or adsorption medium before batch production.',
        icon: 'tabler:flask',
      },
      {
        title: 'Product recommendation',
        description: 'A recommendation based on measured data rather than catalogue assumptions.',
        icon: 'tabler:file-check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=1600&q=80',
      alt: 'Laboratory material testing',
    }}
  />

  <Features
    id="capabilities"
    tagline="Technical capabilities"
    title="From Material Development to Verified Performance"
    subtitle="Characterization, testing and quality control support the material-selection process."
    columns={3}
    items={[
      {
        title: 'Material Characterization',
        description: 'BET surface area and pore structure, XRF elemental composition, XRD crystal phase and ICP metal content analysis.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Dynamic Adsorption Testing',
        description: 'Dynamic simulation testing against the target gas or adsorption medium under controlled conditions.',
        icon: 'tabler:wind',
      },
      {
        title: 'Catalyst Performance Testing',
        description: 'Catalyst activity evaluation under simulated operating conditions.',
        icon: 'tabler:flame',
      },
      {
        title: 'Mechanical Testing',
        description: 'Compressive strength, wear resistance and physical property testing.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Quality Control',
        description: 'Incoming material, process and final inspection with batch traceability.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Field Testing',
        description: 'Documented industrial field tests with original records retained for reference.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <Features2
    id="evidence"
    tagline="Field evidence"
    title="Field-Tested Industrial Applications"
    subtitle="Results below are specific to the tested operating conditions and should not be interpreted as a universal performance guarantee."
    columns={2}
    items={[
      {
        title: 'Sintering Machine CO Removal',
        description:
          'Field test recorded CO concentration reduction from 1,499 ppm to 18 ppm under the stated test conditions — approximately 98.8% CO reduction.',
        icon: 'tabler:flame',
        href: '/case-studies/sintering-machine-co-removal/',
      },
      {
        title: 'Medical Waste Incinerator CO Removal',
        description:
          'Field test recorded CO concentration reduction from 11,224.2 mg/Nm³ to 16.2 mg/Nm³ under the stated test conditions — approximately 99.86% CO reduction.',
        icon: 'tabler:recycle',
        href: '/case-studies/medical-waste-incinerator-co-removal/',
      },
    ]}
  />

  <Content
    tagline="Why Xuanbao"
    title="Selection Support, Not Catalogue Sales"
    items={[
      {
        title: 'Material Development',
        description: 'Formulation, activation and modification developed according to application requirements.',
      },
      {
        title: 'Controlled Manufacturing',
        description: 'Defined production processes with incoming, process and final inspection.',
      },
      {
        title: 'Testing',
        description: 'Material characterization and performance testing using available analytical methods.',
      },
      {
        title: 'Engineering Support',
        description: 'Preliminary material selection based on your gas or liquid operating conditions.',
      },
      {
        title: 'Field Experience',
        description: 'Documented application data where original test records are available.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1600&q=80',
      alt: 'Engineer reviewing material samples in a laboratory',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Industrial conditions are never identical</h3>
      Material selection must follow the actual operating conditions — that is how we work.
    </Fragment>
  </Content>

  <FAQs
    id="faqs"
    tagline="FAQs"
    title="Frequently Asked Questions"
    subtitle="Common questions from industrial buyers."
    schema
    items={[
      {
        title: 'How should I select activated carbon for my application?',
        description:
          'Selection starts with the operating conditions: target contaminant, concentration, gas or liquid flow, temperature, humidity, contact conditions, pressure drop budget and required service life. Send us these parameters and we will propose a preliminary material-selection approach.',
      },
      {
        title: 'Can you customize catalysts or adsorbents for our specific conditions?',
        description:
          'Yes. We select and optimize the material system — formulation, structure and geometry — based on your gas composition, temperature, concentration, flow, humidity, SO₂ and dust conditions. Dynamic simulation testing against your target medium is available before batch production.',
      },
      {
        title: 'Do you support small trial quantities?',
        description:
          'Yes, trial or sampling quantities are available for evaluation. Please describe your application and operating conditions so we can recommend the right trial product.',
      },
      {
        title: 'What documentation is provided with the products?',
        description:
          'Production and quality records are provided with shipments. Third-party or customer-specified testing is available on request. Original field test records are retained for reference.',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Send Your Operating Conditions', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Need help selecting activated carbon or <span class="text-accent">an industrial treatment material?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Send your application, target contaminant, flow rate, concentration, temperature, humidity and other relevant
      operating conditions. We will review the available information and discuss a preliminary material-selection
      approach.
    </Fragment>
  </CallToAction>
</Layout>
