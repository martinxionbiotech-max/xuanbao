---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Note from '~/components/widgets/Note.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Industrial Catalysts & VOC Emission Control Materials Manufacturer',
  description:
    'Xuanbao Environmental Technology manufactures SCR denitrification catalysts, CO oxidation catalysts, VOC catalysts, zeolite molecular sieves and activated carbon for industrial emission control applications.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Industrial Emission Control Materials"
    actions={[
      { variant: 'primary', text: 'Request a Technical Assessment', href: '/contact/', icon: 'tabler:arrow-right' },
      { text: 'Explore Products', href: '/products/' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516937941344-00b4e0337589?auto=format&fit=crop&w=1600&q=80',
      alt: 'Industrial plant pipes',
    }}
  >
    <Fragment slot="title">
      Catalysts &amp; adsorbent materials for <span class="text-accent">cleaner industrial gas</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">SCR DeNOx Catalysts · CO Oxidation Catalysts · VOC Catalysts · Zeolite Molecular
      Sieves · Activated Carbon</span> — developed, manufactured and tested by Yancheng Xuanbao Environmental
      Technology for power, steel, petrochemical, chemical, building materials, coating, printing, pharmaceutical
      and other industrial customers. We select and customize catalyst and adsorbent systems based on your pollutant
      composition, gas temperature, concentration, flow rate, humidity, dust and operating conditions.
    </Fragment>
  </Hero>

  <Stats
    stats={[
      { title: 'Product families', amount: '5' },
      { title: 'Product models', amount: '15' },
      { title: 'Industries served', amount: '12' },
      { title: 'Documented field tests', amount: '2' },
    ]}
  />

  <Features
    id="products"
    tagline="What we supply"
    title="Industrial Emission Control Materials"
    subtitle="Five material families covering the main catalytic and adsorption routes in industrial gas treatment."
    columns={3}
    items={[
      {
        title: 'SCR DeNOx Catalysts',
        description:
          'NOx removal for industrial flue gas — plate-type and honeycomb V-Mo-Ti systems for thermal power, steel, cement, alumina and high-dust exhaust.',
        icon: 'tabler:wind',
        callToAction: { text: 'View SCR catalysts', href: '/products/scr-denox-catalysts/' },
      },
      {
        title: 'CO Oxidation Catalysts',
        description:
          'Precious-metal active systems designed for different gas conditions, covering a wide temperature range with SO₂, water and dust tolerance.',
        icon: 'tabler:flame',
        callToAction: { text: 'View CO catalyst', href: '/products/co-removal-catalyst/' },
      },
      {
        title: 'VOC Catalysts',
        description:
          'Pt, Pt-Pd and non-precious-metal composite oxide honeycomb catalysts for catalytic combustion of VOCs.',
        icon: 'tabler:atom',
        callToAction: { text: 'View VOC catalysts', href: '/products/voc-catalysts/' },
      },
      {
        title: 'Zeolite Molecular Sieves',
        description:
          'Modified 5A, 13X, ZSM-5 and NaY for VOC adsorption concentration, gas drying, separation and purification.',
        icon: 'tabler:hexagons',
        callToAction: { text: 'View molecular sieves', href: '/products/zeolite-molecular-sieve/' },
      },
      {
        title: 'Activated Carbon',
        description:
          'Honeycomb, columnar, coconut-shell and fiber forms for gas-phase adsorption, solvent recovery and odor control.',
        icon: 'tabler:layers-linked',
        callToAction: { text: 'View activated carbon', href: '/products/activated-carbon/' },
      },
      {
        title: 'Heating Components',
        description: 'Heating elements supporting catalytic oxidation and adsorption-desorption systems.',
        icon: 'tabler:temperature',
        callToAction: { text: 'View heating components', href: '/products/heating-tubes/' },
      },
    ]}
  />

  <Content
    isReversed
    tagline="Who we are"
    title="From Material Development to Industrial Application"
    items={[
      {
        title: 'Technical R&D',
        description:
          'Continuous investment in catalyst and adsorbent development with laboratory capability and cooperation with universities and research institutes.',
      },
      {
        title: 'Customized Materials',
        description:
          'We select and optimize materials by gas composition, concentration, flow rate, temperature, humidity, dust, SO₂ and target removal efficiency.',
      },
      {
        title: 'Experimental Verification',
        description:
          'Before batch production, molecular sieve products can be dynamically simulated against the target medium; formulation and forming are adjusted from test results.',
      },
      {
        title: 'Quality Control',
        description:
          'QA/QC procedures cover production process and product quality, with third-party or customer-specified testing available.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1600&q=80',
      alt: 'Engineer working in industrial laboratory',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Industrial exhaust is never identical</h3>
      Material selection must follow the actual gas conditions — that is how we work.
    </Fragment>
  </Content>

  <Steps
    title="Technology-driven environmental materials"
    items={[
      {
        title: 'R&D & testing',
        description: 'BET, XRF, XRD, ICP characterization, zeolite synthesis, modification treatment and performance evaluation.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Customization',
        description: 'Dynamic simulation testing against your target medium before batch production.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'Quality control',
        description: 'Process and product QA/QC with third-party or customer-specified testing available.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Lifecycle support',
        description: 'Installation guidance, performance evaluation and replacement recommendations.',
        icon: 'tabler:lifebuoy',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=1600&q=80',
      alt: 'Industrial quality inspection',
    }}
  />

  <Features2
    id="industries"
    tagline="Applications"
    title="Applications Across Industrial Emission Control"
    subtitle="Materials matched to each industry's emission problems."
    columns={4}
    items={[
      { title: 'Thermal Power', description: 'High-temperature, high-dust SCR DeNOx.', icon: 'tabler:power', href: '/industries/thermal-power/' },
      { title: 'Steel & Sintering', description: 'Sintering gas, CO removal and catalytic oxidation.', icon: 'tabler:flame', href: '/industries/steel/' },
      { title: 'Cement & Building Materials', description: 'High-dust industrial gas treatment.', icon: 'tabler:building-factory-2', href: '/industries/cement/' },
      { title: 'Petrochemical & Chemical', description: 'VOC catalytic oxidation and adsorption concentration.', icon: 'tabler:flask', href: '/industries/petrochemical/' },
      { title: 'Coating & Printing', description: 'Benzene, toluene, xylene, esters and alcohol VOC control.', icon: 'tabler:paint', href: '/industries/coating/' },
      { title: 'Pharmaceutical', description: 'Complex organic exhaust adsorption and oxidation.', icon: 'tabler:pill', href: '/industries/pharmaceutical/' },
      { title: 'Automotive Manufacturing', description: 'Paint shop VOC emission control.', icon: 'tabler:car', href: '/industries/automotive/' },
      { title: 'Waste Incineration', description: 'CO and organic pollutant control.', icon: 'tabler:recycle', href: '/industries/waste-incineration/' },
    ]}
  />

  <Content
    tagline="Field results"
    title="Selected Industrial Applications"
    items={[
      {
        title: 'Sintering Machine CO Removal',
        description: 'Field test: CO 1,499 ppm → 18 ppm — tested 2022-08-23.',
      },
      {
        title: 'Medical Waste Incinerator',
        description: 'Field test: CO 11,224.2 mg/Nm³ → 16.2 mg/Nm³ — tested 2023-03-20.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=1600&q=80',
      alt: 'Industrial facility',
    }}
  >
    <Fragment slot="content">
      Original test records, operating conditions and test organizations are retained for reference;{' '}
      <a class="font-semibold text-primary hover:underline" href="/case-studies/">view the case studies</a> for details.
    </Fragment>
  </Content>

  <Note
    title="Need help selecting the right catalyst or adsorbent?"
    description="Provide gas flow rate, composition, temperature, humidity, SO₂, dust and target concentrations — we will make a preliminary material selection."
  />

  <FAQs
    id="faqs"
    tagline="FAQs"
    title="Frequently Asked Questions"
    subtitle="Common questions from industrial buyers."
    schema
    items={[
      {
        title: 'Can you customize catalysts for our specific gas conditions?',
        description:
          'Yes. We select and optimize the material system — formulation, structure and geometry — based on your gas composition, temperature, concentration, flow, humidity, SO₂ and dust conditions. Dynamic simulation testing against your target medium is available before batch production.',
      },
      {
        title: 'Do you support small trial quantities?',
        description:
          'Yes, trial or sampling quantities are available for evaluation. Please describe your application and operating conditions so we can recommend the right trial product.',
      },
      {
        title: 'What documentation is provided with the products?',
        description:
          'Production and quality records are provided with shipments. Third-party or customer-specified testing is available on request. Original field test records are retained for reference.',
      },
      {
        title: 'Do you export?',
        description:
          'Yes, we supply international industrial customers. Please contact us with your destination and application for delivery and documentation details.',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Request a Technical Consultation', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Tell us your <span class="text-accent">gas conditions</span>
    </Fragment>

    <Fragment slot="subtitle">
      Gas composition + flow + concentration + temperature + humidity + dust + existing equipment — we will discuss
      the right catalyst or adsorbent solution with you.
    </Fragment>
  </CallToAction>
</Layout>
