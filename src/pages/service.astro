---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Note from '~/components/widgets/Note.astro';

const metadata = {
  title: 'Technical & After-Sales Service',
  description:
    'Full lifecycle service: pre-order consultation and selection, production communication, installation guidance, operation support and end-of-life catalyst recycling guidance.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'About Us', href: '/about/' }, { text: 'Service' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">About Us</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Technical &amp; After-Sales Service
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Support across the full product lifecycle — before, during and after the order.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-12">
    <Features
      columns={3}
      items={[
        {
          title: 'Before Order',
          description: 'Process consultation, material selection, preliminary technical assessment, product specification discussion, sample testing.',
          icon: 'tabler:clipboard-list',
        },
        {
          title: 'During Production',
          description: 'Production status communication, product inspection, packaging, documentation.',
          icon: 'tabler:assembly',
        },
        {
          title: 'Installation',
          description: 'Catalyst installation guidance, module installation, SCR commissioning guidance.',
          icon: 'tabler:tool',
        },
        {
          title: 'Operation',
          description: 'Sampling, performance testing, technical follow-up, replacement evaluation.',
          icon: 'tabler:activity',
        },
        {
          title: 'End of Life',
          description: 'Used catalyst recycling guidance, disposal consultation, replacement planning.',
          icon: 'tabler:recycle',
        },
        {
          title: 'After-Sales',
          description: '24-hour response for after-sales inquiries, regular follow-up.',
          icon: 'tabler:headset',
        },
      ]}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Information we ask for at inquiry stage</h2>
      <p class="text-muted mb-4 max-w-3xl mx-auto text-center">
        A complete brief shortens the selection cycle. For catalyst and adsorbent projects, the key inputs are:
      </p>
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40 p-1"><table class="w-full text-sm md:text-base"><tbody><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Gas stream</td><td class="px-3 py-2 align-top text-muted">flow rate, temperature, humidity, dust loading, O₂ and SO₂ content.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Pollutants</td><td class="px-3 py-2 align-top text-muted">species and concentration range — including peaks, not just averages.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Performance target</td><td class="px-3 py-2 align-top text-muted">required removal efficiency, outlet limit or recovery objective.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Application context</td><td class="px-3 py-2 align-top text-muted">industry, equipment type, available space and layout constraints.</td></tr></tbody></table></div>
      <p class="text-muted mt-4 text-sm max-w-3xl mx-auto text-center">
        Selection logic by application: <a class="text-primary hover:underline" href="/applications/gas-purification/">gas purification</a>,{' '}
        <a class="text-primary hover:underline" href="/applications/nox-reduction/">NOx reduction</a>,{' '}
        <a class="text-primary hover:underline" href="/applications/co-removal/">CO removal</a> — or browse the{' '}
        <a class="text-primary hover:underline" href="/industries/">industry guides</a>.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Documentation we provide</h2>
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40 p-1"><table class="w-full text-sm md:text-base"><tbody><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Product specifications</td><td class="px-3 py-2 align-top text-muted">defined property ranges with the data type marked (specification, typical or test result).</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Test data</td><td class="px-3 py-2 align-top text-muted">laboratory and application test results with conditions — see <a class="text-primary hover:underline" href="/testing/">testing capabilities</a>.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Quality records</td><td class="px-3 py-2 align-top text-muted">batch traceability and inspection records — see <a class="text-primary hover:underline" href="/quality/">QA / QC procedures</a>.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Installation & operation</td><td class="px-3 py-2 align-top text-muted">installation guidance, commissioning support and operating parameter recommendations.</td></tr></tbody></table></div>
    </section>

    <Note variant="info">
      <Fragment slot="description">
        Field performance depends on operating conditions. Data from one application — such as the documented CO
        removal field tests — is valid for the tested conditions, not a universal guarantee.{' '}
        <a class="text-primary hover:underline" href="/case-studies/">See field test records</a>.
      </Fragment>
    </Note>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'Contact Technical Support', href: '/contact/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Support across the <span class="text-accent">full lifecycle</span>
    </Fragment>
  </CallToAction>
</Layout>
