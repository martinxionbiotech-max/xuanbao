---
import BaseLayout from '../layouts/BaseLayout.astro';

const SITE = 'https://xuanbaoenvironment.com';
const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'About Us', item: SITE + '/about/' },
    { '@type': 'ListItem', position: 3, name: 'Service' },
  ],
});
---

<BaseLayout
  title="Technical & After-Sales Service | Xuanbao Environmental"
  description="Full lifecycle service: pre-order consultation and selection, production communication, installation guidance, operation support and end-of-life catalyst recycling guidance."
  canonical="/service/"
  schema={[breadcrumb]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li class="sep">/</li>
        <li><a href="/about/">About Us</a></li>
        <li class="sep">/</li>
        <li>Service</li>
      </ol>
    </div>
  </nav>

  <section class="page-head">
    <div class="container">
      <h1>Technical &amp; After-Sales Service</h1>
      <p>Support across the full product lifecycle — before, during and after the order.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="container prose-narrow">
      <div class="grid-3">
        <div class="card">
          <h3>Before Order</h3>
          <ul>
            <li>Process consultation</li>
            <li>Material selection</li>
            <li>Preliminary technical assessment</li>
            <li>Product specification discussion</li>
            <li>Sample testing</li>
          </ul>
        </div>
        <div class="card">
          <h3>During Production</h3>
          <ul>
            <li>Production status communication</li>
            <li>Product inspection</li>
            <li>Packaging</li>
            <li>Documentation</li>
          </ul>
        </div>
        <div class="card">
          <h3>Installation</h3>
          <ul>
            <li>Catalyst installation guidance</li>
            <li>Module installation</li>
            <li>SCR commissioning guidance</li>
          </ul>
        </div>
        <div class="card">
          <h3>Operation</h3>
          <ul>
            <li>Sampling</li>
            <li>Performance testing</li>
            <li>Technical follow-up</li>
            <li>Replacement evaluation</li>
          </ul>
        </div>
        <div class="card">
          <h3>End of Life</h3>
          <ul>
            <li>Used catalyst recycling guidance</li>
            <li>Disposal consultation</li>
            <li>Replacement planning</li>
          </ul>
        </div>
        <div class="card">
          <h3>After-Sales</h3>
          <ul>
            <li>24-hour response for after-sales inquiries</li>
            <li>Regular follow-up</li>
          </ul>
        </div>
      </div>

      <p><a class="btn btn-dark" href="/contact/">Contact Technical Support</a></p>
    </div>
  </section>
</BaseLayout>
