---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Technical & After-Sales Service',
  description:
    'Full lifecycle service: pre-order consultation and selection, production communication, installation guidance, operation support and end-of-life catalyst recycling guidance.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'About Us', href: '/about/' }, { text: 'Service' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">About Us</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      Technical &amp; After-Sales Service
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">
      Support across the full product lifecycle — before, during and after the order.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10">
    <Features
      columns={3}
      items={[
        {
          title: 'Before Order',
          description: 'Process consultation, material selection, preliminary technical assessment, product specification discussion, sample testing.',
          icon: 'tabler:clipboard-list',
        },
        {
          title: 'During Production',
          description: 'Production status communication, product inspection, packaging, documentation.',
          icon: 'tabler:assembly',
        },
        {
          title: 'Installation',
          description: 'Catalyst installation guidance, module installation, SCR commissioning guidance.',
          icon: 'tabler:tool',
        },
        {
          title: 'Operation',
          description: 'Sampling, performance testing, technical follow-up, replacement evaluation.',
          icon: 'tabler:activity',
        },
        {
          title: 'End of Life',
          description: 'Used catalyst recycling guidance, disposal consultation, replacement planning.',
          icon: 'tabler:recycle',
        },
        {
          title: 'After-Sales',
          description: '24-hour response for after-sales inquiries, regular follow-up.',
          icon: 'tabler:headset',
        },
      ]}
    />
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'Contact Technical Support', href: '/contact/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Support across the <span class="text-accent">full lifecycle</span>
    </Fragment>
  </CallToAction>
</Layout>
