---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Privacy Policy',
  description:
    'Privacy policy for xuanbaoenvironment.com — how Yancheng Xuanbao Environmental Technology Co., Ltd. handles information submitted through this website.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Legal</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Privacy Policy
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      <em>Last updated: September 2026</em>
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Scope</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        This privacy policy explains how Yancheng Xuanbao Environmental Technology Co., Ltd. ("Xuanbao", "we")
        handles information on this website.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Information You Send Us</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        When you contact us through the inquiry form or by email, you share the information you choose to provide —
        typically your name, company, email address and details of your gas treatment requirements. We use this
        information only to respond to your inquiry and to prepare technical assessments and quotations.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Cookies &amp; Analytics</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        This website does not use advertising cookies or third-party trackers. Where analytics are enabled, they are
        used to understand aggregate site usage.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Hosting &amp; Infrastructure</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        This website is a static site hosted on Cloudflare Pages. The hosting provider may process technical access
        logs for security and performance purposes.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Sharing</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        We do not sell or rent personal information. We share information only as necessary to respond to your
        inquiry, or where required by law.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Contact</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        For privacy questions, contact us at{' '}
        <a class="text-primary hover:underline" href="mailto:625534887@qq.com">625534887@qq.com</a>.
      </p>
    </section>
  </div>
</Layout>
