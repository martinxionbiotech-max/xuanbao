---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Terms of Use',
  description:
    'Terms of use for xuanbaoenvironment.com — acceptable use of the website, content accuracy, intellectual property and limitation of liability.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Legal</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Terms of Use
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      <em>Last updated: September 2026</em>
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Acceptance of These Terms</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        By accessing this website, you agree to these terms of use. If you do not agree, please do not use this
        website.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Website Content</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        The content on this website is provided for general information about Yancheng Xuanbao Environmental
        Technology Co., Ltd. and its products. Product data is presented as manufacturer specifications, typical
        values or test results as indicated on each page; values marked (*) are reference values from source
        documentation. Technical content does not constitute engineering design advice — designs must be confirmed
        per project after operating conditions are reviewed.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Intellectual Property</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        Text, graphics, product photographs and specification sheets on this website are the property of Yancheng
        Xuanbao Environmental Technology Co., Ltd. unless otherwise stated. They may not be reproduced or
        redistributed without prior written permission.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Inquiries &amp; Quotations</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        Information submitted through the contact form or by email is handled as described in our Privacy Policy.
        A quotation or technical response does not create a contractual obligation; orders are confirmed only by
        written agreement between the parties.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Limitation of Liability</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        This website is provided "as is" without warranties of any kind. To the fullest extent permitted by law,
        Yancheng Xuanbao Environmental Technology Co., Ltd. is not liable for damages arising from the use of, or
        reliance on, the content of this website.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Changes</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        We may update these terms from time to time. The current version is always published on this page.
      </p>
    </section>
  </div>
</Layout>
