---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Industrial Materials: Activated Carbon & Adsorption Systems | Xuanbao',
  description:
    'Material-level guide to Xuanbao industrial materials: coconut-shell and coal-based activated carbon by raw material, honeycomb/columnar/fiber by form, and how material properties determine application suitability.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeroText
    badge="Materials"
    title="Industrial Materials: Activated Carbon & Adsorption Systems"
    subtitle="Materials are selected by properties and operating conditions — raw material, pore structure, form and measured performance together decide what fits your application."
  />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 pb-8 space-y-14">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-2">By raw material</h2>
      <p class="text-muted mb-6 max-w-3xl">
        Raw material is the starting point of activated carbon performance — it shapes the pore structure,
        hardness, ash content and density of the finished material. The raw material does not by itself decide
        the application: the measured properties of the specific product do.
      </p>
      <Features
        columns={2}
        items={[
          {
            title: 'Coconut Shell Activated Carbon',
            description:
              'High hardness, low ash and a typically microporous structure. Supplied for applications where suitable small-molecule adsorption and high surface-area characteristics are required.',
            icon: 'tabler:nut',
            callToAction: { text: 'Coconut shell carbon materials', href: '/materials/coconut-shell-carbon/' },
          },
          {
            title: 'Coal-Based Activated Carbon',
            description:
              'Produced from selected coal through carbonization and activation. Supplied in columnar form for gas purification and packed-bed adsorption duty.',
            icon: 'tabler:layers-subtract',
            callToAction: { text: 'Coal-based carbon materials', href: '/materials/coal-based-carbon/' },
          },
        ]}
      />
      <p class="text-muted mt-4 text-sm">
        Product forms: <a href="/products/activated-carbon/coconut-shell-carbon/" class="text-primary hover:underline">coconut-shell products</a>,
        <a href="/products/activated-carbon/coal-based-columnar-carbon/" class="text-primary hover:underline">coal-based columnar products</a>.
        Other raw-material systems — fruit-shell, bamboo or wood-based carbons, granular or powdered forms — can
        be discussed for specific applications. We confirm supply from the application, not the other way around.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-2">By product form</h2>
      <p class="text-muted mb-6 max-w-3xl">
        Form is a separate selection dimension: the same material family can be supplied in different geometries
        for different contact conditions and pressure-drop budgets.
      </p>
      <Features
        columns={3}
        items={[
          {
            title: 'Honeycomb',
            description: 'Low pressure drop and structured contact surface for high-flow gas treatment.',
            icon: 'tabler:hexagons',
            callToAction: { text: 'Honeycomb activated carbon', href: '/products/activated-carbon/honeycomb-activated-carbon/' },
          },
          {
            title: 'Columnar',
            description: 'High density, low dust, reactivatable — for gas-phase packed beds.',
            icon: 'tabler:columns-3',
            callToAction: { text: 'Columnar activated carbon', href: '/products/activated-carbon/coal-based-columnar-carbon/' },
          },
          {
            title: 'Fiber',
            description: 'Very fast kinetics for low-concentration, fast-cycling gas duty.',
            icon: 'tabler:line',
            callToAction: { text: 'Activated carbon fiber', href: '/products/activated-carbon/activated-carbon-fiber/' },
          },
        ]}
      />
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-2">How materials are selected</h2>
      <p class="text-muted mb-6 max-w-3xl">
        Material selection follows the operating conditions:
      </p>
      <ol class="list-decimal list-inside space-y-2 text-muted max-w-3xl">
        <li>Target contaminant — what must be adsorbed or treated, and its concentration.</li>
        <li>Medium and conditions — gas or liquid, temperature, humidity, flow, contact time.</li>
        <li>Material system — raw material and pore structure matched to the contaminant.</li>
        <li>Form — geometry matched to the pressure-drop budget and equipment.</li>
        <li>Verification — capacity or activity confirmed by testing before batch supply.</li>
      </ol>
      <p class="text-muted mt-4 text-sm">
        Technical background on properties and mechanisms is published in the{' '}
        <a href="https://data.xuanbaoenvironment.com/activated-carbon/" class="text-primary hover:underline">
          activated carbon knowledge guide</a>.
      </p>
    </section>
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Send Your Operating Conditions', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Which material fits <span class="text-accent">your conditions?</span>
    </Fragment>
    <Fragment slot="subtitle">
      Send flow rate, concentration, temperature and composition — we recommend the material system and form.
    </Fragment>
  </CallToAction>
</Layout>
