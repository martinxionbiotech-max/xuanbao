---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';

import { industries } from '~/data/industries';
import { getPermalink } from '~/utils/permalinks';

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { slug: ind.slug }, props: { industry: ind } }));
}

const { industry } = Astro.props;
const ind = industry as (typeof industries)[number];
---

<Layout metadata={{ title: ind.seoTitle, description: ind.metaDescription, ignoreTitleTemplate: true }}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Industries', href: '/industries/' }, { text: ind.name }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">Industry</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      {ind.h1}
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">
      Emission problems, pollutants, operating conditions and recommended materials for the {ind.name.toLowerCase()}{' '}
      sector.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Typical emission problems</h2>
      <ul class="grid gap-3 sm:grid-cols-2 text-muted" set:html={ind.problems} />
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Main pollutants</h2>
      <ul class="grid gap-3 sm:grid-cols-2 text-muted" set:html={ind.pollutants} />
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Operating conditions</h2>
      <p class="text-muted leading-relaxed" set:html={ind.conditions} />
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Recommended material selection</h2>
      <ul class="grid gap-3 sm:grid-cols-2 text-muted" set:html={ind.selection} />
    </section>

    <Features2
      title="Related products"
      columns={ind.products.length > 2 ? 3 : 2}
      items={ind.products.map((p) => ({
        title: p.name,
        icon: 'tabler:box',
        href: getPermalink(p.href.replace(/\/+$/, '')),
      }))}
    />
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Submit Operating Conditions', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Tell us about <span class="text-accent">your stream</span>
    </Fragment>
    <Fragment slot="subtitle">
      Gas flow, concentration, temperature, humidity, SO₂ and dust — we will recommend the right catalyst or adsorbent system.
    </Fragment>
  </CallToAction>
</Layout>
