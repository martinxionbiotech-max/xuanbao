---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { industries } from '~/data/industries';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Industries Served',
  description:
    'Emission control materials for thermal power, steel, sintering, cement, alumina, petrochemical, chemical, printing, coating, pharmaceutical, automotive and waste incineration.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeroText
    badge="Industries"
    title="Industries Served"
    subtitle="Materials matched to each industry's emission problems — 12 sectors, each with its own operating conditions."
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10">
    <Features2
      columns={4}
      items={industries.map((ind) => ({
        title: ind.name,
        description: ind.metaDescription.split('.')[0] + '.',
        icon: 'tabler:building-factory-2',
        href: getPermalink('/industries/' + ind.slug),
      }))}
    />
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Submit Operating Conditions', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Send us your <span class="text-accent">operating conditions</span>
    </Fragment>
    <Fragment slot="subtitle">
      Gas flow, concentration, temperature, humidity, SO₂ and dust — we will recommend the right catalyst or adsorbent system.
    </Fragment>
  </CallToAction>
</Layout>
