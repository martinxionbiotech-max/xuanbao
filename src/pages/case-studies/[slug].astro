---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { caseStudies } from '~/data/cases';
import { caseDetails } from '~/data/details';
import { getPermalink } from '~/utils/permalinks';

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { caseStudy: c } }));
}

const { caseStudy } = Astro.props;
const cs = caseStudy as (typeof caseStudies)[number];
---

<Layout metadata={{ title: cs.seoTitle, description: cs.metaDescription, ignoreTitleTemplate: true }}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Case Studies', href: '/case-studies/' }, { text: cs.name }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">Case Study</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      {cs.h1}
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">{cs.intro}</p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <section class="rounded-xl border border-primary/30 bg-primary/10 p-5 md:p-6">
      <strong class="text-heading">Reported field test result — test date {cs.testDate}</strong>
      <p class="mt-2 text-muted leading-relaxed" set:html={cs.result} />
    </section>

    {cs.sections.map((sec) => (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">{sec.h2}</h2>
        <p class="text-muted leading-relaxed" set:html={sec.body} />
        {sec.list && <ul class="mt-4 grid gap-2 text-muted" set:html={sec.list} />}
      </section>
    ))}

    {caseDetails[cs.slug] && (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Engineering takeaways</h2>
        <div class="space-y-4 text-muted leading-relaxed" set:html={caseDetails[cs.slug]} />
      </section>
    )}

    <Features2
      title="Related products"
      columns={cs.products.length > 2 ? 3 : 2}
      items={cs.products.map((p) => ({
        title: p.name,
        icon: 'tabler:box',
        href: getPermalink(p.href.replace(/\/+$/, '')),
      }))}
    />
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Contact Us', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Discuss a <span class="text-accent">similar application</span>
    </Fragment>
    <Fragment slot="subtitle">
      Planning CO or VOC control on a comparable stream? Share your operating conditions with us.
    </Fragment>
  </CallToAction>
</Layout>
