---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Note from '~/components/widgets/Note.astro';

import { caseStudies } from '~/data/cases';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Case Studies',
  description:
    'Documented field tests: sintering machine CO removal (1,499 → 18 ppm) and medical waste incinerator CO removal (11,224.2 → 16.2 mg/Nm³).',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeroText
    badge="Case Studies"
    title="Field Test Records"
    subtitle="Documented industrial field tests with original records retained for reference."
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <Features2
      columns={2}
      items={caseStudies.map((cs) => ({
        title: cs.name,
        description: `${cs.result} — tested ${cs.testDate}.`,
        icon: 'tabler:chart-line',
        href: getPermalink('/case-studies/' + cs.slug),
      }))}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">What these records are — and are not</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        The records are point measurements from industrial field tests: CO concentration at the catalyst inlet and
        outlet on the test date, with the operating context documented where available. They evidence real-stream
        performance under stated conditions — not a universal performance guarantee for every plant.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">How we read a field test</h2>
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40 p-1"><table class="w-full text-sm md:text-base"><tbody><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Result</td><td class="px-3 py-2 align-top text-muted">inlet → outlet concentration on the test date.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Context</td><td class="px-3 py-2 align-top text-muted">flow rate, temperature, O₂, moisture, SO₂ and dust at the test position.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Sizing basis</td><td class="px-3 py-2 align-top text-muted">peak loads, not averages — the reactor is sized for the worst realistic condition.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">Verification</td><td class="px-3 py-2 align-top text-muted">original test records, operating conditions and testing organizations are retained for reference.</td></tr></tbody></table></div>
      <p class="text-muted mt-4 text-sm text-center">
        Related reading: <a class="text-primary hover:underline" href="/testing/">testing capabilities</a>,{' '}
        <a class="text-primary hover:underline" href="/applications/co-removal/">CO removal application</a>,{' '}
        <a class="text-primary hover:underline" href="/industries/sintering/">sintering</a> and{' '}
        <a class="text-primary hover:underline" href="/industries/waste-incineration/">waste incineration</a> industry guides.
      </p>
    </section>

    <Note variant="info">
      <Fragment slot="description">
        Original test records, operating conditions and test organizations are retained for reference; contact us for
        discussion of similar applications.
      </Fragment>
    </Note>
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Discuss a Similar Application', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Planning CO or VOC control on a <span class="text-accent">comparable stream?</span>
    </Fragment>
    <Fragment slot="subtitle">
      Share your operating conditions — we will size the right material system for it.
    </Fragment>
  </CallToAction>
</Layout>
