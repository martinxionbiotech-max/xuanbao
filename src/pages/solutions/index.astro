---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { solutions } from '~/data/solutions';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Emission Control Solutions',
  description:
    'Engineered emission control routes: VOC catalytic oxidation, zeolite adsorption concentration, SCR DeNOx, CO removal and adsorption + catalytic combustion.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeroText
    badge="Solutions"
    title="Emission Control Solutions"
    subtitle="Engineered treatment routes that combine our catalysts and adsorbents — each sized to the actual gas conditions."
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10">
    <Features2
      columns={3}
      tagline="Routes"
      title="Solution routes"
      items={solutions.map((s) => ({
        title: s.name,
        description: s.intro,
        icon: 'tabler:route',
        href: getPermalink('/solutions/' + s.slug),
      }))}
    />
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Discuss Your Gas Conditions', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Not sure which <span class="text-accent">route fits?</span>
    </Fragment>
    <Fragment slot="subtitle">
      Share flow rate, concentration, temperature and composition — we will recommend the right material system.
    </Fragment>
  </CallToAction>
</Layout>
