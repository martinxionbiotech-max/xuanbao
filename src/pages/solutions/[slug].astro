---
import { solutions } from '../../data/solutions';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { solution: s } }));
}

const { solution } = Astro.props;
const s = solution as (typeof solutions)[number];
const SITE = 'https://xuanbaoenvironment.com';
const url = SITE + '/solutions/' + s.slug + '/';

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: SITE + '/solutions/' },
    { '@type': 'ListItem', position: 3, name: s.name },
  ],
});
---

<BaseLayout title={s.seoTitle} description={s.metaDescription} canonical={`/solutions/${s.slug}/`} schema={[breadcrumb]}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li class="sep">/</li>
        <li><a href="/solutions/">Solutions</a></li>
        <li class="sep">/</li>
        <li>{s.name}</li>
      </ol>
    </div>
  </nav>

  <section class="page-head">
    <div class="container">
      <h1>{s.h1}</h1>
      <p>{s.intro}</p>
    </div>
  </section>

  <section class="page-body">
    <div class="container prose-narrow">
      {s.flow && (
        <div class="flow">
          <h4>{s.flow.title}</h4>
          <div class="flow-steps">
            {s.flow.steps.map((step, i) => (
              <>
                <span>{step}</span>
                {i < s.flow!.steps.length - 1 && <i>→</i>}
              </>
            ))}
          </div>
        </div>
      )}

      {s.sections.map((sec) => (
        <>
          <h2>{sec.h2}</h2>
          <p set:html={sec.body} />
          {sec.list && <ul set:html={sec.list} />}
          {sec.table && (
            <div class="table-wrap">
              <table class="data" set:html={sec.table} />
            </div>
          )}
        </>
      ))}

      <h2>Related products</h2>
      <div class="grid-3">
        {s.products.map((p) => (
          <div class="card">
            <a class="title-link" href={p.href}>{p.name}</a>
          </div>
        ))}
      </div>

      <div class="cta-band">
        <h2>Discuss your gas conditions</h2>
        <p>Share your flow rate, concentration, temperature and composition — we will recommend the right material system.</p>
        <a class="btn btn-primary" href="/contact/">Request a Technical Consultation</a>
      </div>
    </div>
  </section>
</BaseLayout>
