---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { solutions } from '~/data/solutions';
import { getPermalink } from '~/utils/permalinks';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { solution: s } }));
}

const { solution } = Astro.props;
const s = solution as (typeof solutions)[number];
---

<Layout metadata={{ title: s.seoTitle, description: s.metaDescription, ignoreTitleTemplate: true }}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Solutions', href: '/solutions/' }, { text: s.name }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">Solution</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      {s.h1}
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">{s.intro}</p>
  </section>

  {s.flow && (
    <div class="mx-auto max-w-5xl px-4 sm:px-6 pt-6 md:pt-8">
      <Steps
        title={s.flow.title}
        items={s.flow.steps.map((step) => ({ title: step }))}
      />
    </div>
  )}

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10 pt-6 md:pt-10">
    {s.sections.map((sec) => (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">{sec.h2}</h2>
        <p class="text-muted leading-relaxed" set:html={sec.body} />
        {sec.list && <ul class="mt-4 grid gap-2 text-muted" set:html={sec.list} />}
        {sec.table && (
          <div class="mt-4 overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40">
            <table class="w-full text-sm md:text-base" set:html={sec.table} />
          </div>
        )}
      </section>
    ))}

    <Features2
      title="Related products"
      columns={s.products.length > 2 ? 3 : 2}
      items={s.products.map((p) => ({
        title: p.name,
        icon: 'tabler:box',
        href: getPermalink(p.href.replace(/\/+$/, '')),
      }))}
    />
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Request a Technical Consultation', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Discuss your <span class="text-accent">gas conditions</span>
    </Fragment>
    <Fragment slot="subtitle">
      Share your flow rate, concentration, temperature and composition — we will recommend the right material system.
    </Fragment>
  </CallToAction>
</Layout>
