---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE } from 'astrowind:config';
import { categoryMeta, products } from '~/data/products';
import { getPermalink } from '~/utils/permalinks';

export function getStaticPaths() {
  return Object.keys(categoryMeta).map((slug) => ({ params: { category: slug }, props: { slug } }));
}

const { slug } = Astro.props;
const meta = categoryMeta[slug];
const inCategory = products.filter((p) => p.slug[0] === slug);

const baseUrl = String(SITE.site).replace(/\/$/, '');
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.h1,
  description: meta.metaDescription,
  url: baseUrl + getPermalink('/products/' + slug),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: inCategory.length,
    itemListElement: inCategory.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: p.name,
        description: p.intro,
        url: baseUrl + getPermalink('/products/' + p.slug.join('/')),
      },
    })),
  },
};
---

<Layout metadata={{ title: meta.seoTitle, description: meta.metaDescription, ignoreTitleTemplate: true }}>
  <StructuredData slot="head" schema={collectionSchema} />

  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Products', href: '/products/' }, { text: meta.name }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Products</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      {meta.h1}
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">{meta.intro}</p>
    <p class="mt-3 max-w-3xl mx-auto text-muted text-center">{meta.overview}</p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10">
    <Features2
      title="Products in this category"
      columns={inCategory.length > 2 ? 3 : 2}
      items={inCategory.map((p) => ({
        title: p.name,
        description: p.intro,
        icon: 'tabler:box',
        href: getPermalink('/products/' + p.slug.join('/')),
      }))}
    />
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Request a Quotation', href: '/contact/', icon: 'tabler:arrow-right' }, { variant: 'whatsapp', text: 'Chat on WhatsApp', href: 'https://wa.me/8615153588090', icon: 'tabler:brand-whatsapp', target: '_blank' }]}
  >
    <Fragment slot="title">
      Choose the right <span class="text-accent">material for your conditions</span>
    </Fragment>
    <Fragment slot="subtitle">
      Share your gas composition and operating parameters — we will confirm the right model and customization.
    </Fragment>
  </CallToAction>
</Layout>
