---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { categoryMeta, products } from '~/data/products';
import { getPermalink } from '~/utils/permalinks';

export function getStaticPaths() {
  return Object.keys(categoryMeta).map((slug) => ({ params: { category: slug }, props: { slug } }));
}

const { slug } = Astro.props;
const meta = categoryMeta[slug];
const inCategory = products.filter((p) => p.slug[0] === slug);
---

<Layout metadata={{ title: meta.seoTitle, description: meta.metaDescription, ignoreTitleTemplate: true }}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Products', href: '/products/' }, { text: meta.name }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">Products</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      {meta.h1}
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">{meta.intro}</p>
    <p class="mt-3 max-w-3xl text-muted">{meta.overview}</p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10">
    <Features2
      title="Products in this category"
      columns={inCategory.length > 2 ? 3 : 2}
      items={inCategory.map((p) => ({
        title: p.name,
        description: p.intro,
        icon: 'tabler:box',
        href: getPermalink('/products/' + p.slug.join('/')),
      }))}
    />
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Request a Quotation', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Choose the right <span class="text-accent">material for your conditions</span>
    </Fragment>
    <Fragment slot="subtitle">
      Share your gas composition and operating parameters — we will confirm the right model and customization.
    </Fragment>
  </CallToAction>
</Layout>
