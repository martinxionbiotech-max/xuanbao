---
import ProductDetail from '~/components/ProductDetail.astro';

import { products, type Product } from '~/data/products';

export function getStaticPaths() {
  // Multi-segment product slugs only; single-segment pages (co-removal-catalyst, heating-tubes) are static files.
  return products
    .filter((product) => product.slug.length > 1)
    .map((product) => ({
      params: { slug: product.slug.join('/') },
      props: { product },
    }));
}

const { product } = Astro.props;
const p = product as Product;
p.path = '/' + p.slug.join('/') + '/';
---

<ProductDetail product={p} />
