---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Industrial Emission Control Materials — Product Catalog',
  description:
    'Product catalog: SCR DeNOx catalysts, CO oxidation catalysts, VOC catalysts, zeolite molecular sieves (5A, 13X, ZSM-5, NaY) and activated carbon (honeycomb, columnar, coconut shell, fiber).',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeroText
    badge="Products"
    title="Product Catalog"
    subtitle="Catalysts and adsorbent materials for industrial emission control — specifications, application windows and customization."
  />

  <Features
    columns={3}
    tagline="By category"
    title="Material families"
    items={[
      {
        title: 'SCR DeNOx Catalysts',
        description: 'NOx removal for industrial flue gas. Plate-type and honeycomb V-Mo-Ti systems.',
        icon: 'tabler:wind',
        callToAction: { text: 'View category', href: '/products/scr-denox-catalysts/' },
      },
      {
        title: 'CO Oxidation Catalysts',
        description: 'Carbon monoxide oxidation for sintering, incineration, furnaces and boilers.',
        icon: 'tabler:flame',
        callToAction: { text: 'View product', href: '/products/co-removal-catalyst/' },
      },
      {
        title: 'VOC Catalysts',
        description: 'Catalytic combustion catalysts for VOC oxidation — Pt, Pt-Pd and non-precious metal.',
        icon: 'tabler:atom',
        callToAction: { text: 'View category', href: '/products/voc-catalysts/' },
      },
      {
        title: 'Zeolite Molecular Sieves',
        description: 'Selective adsorption, drying, separation and VOC concentration — 5A, 13X, ZSM-5, NaY.',
        icon: 'tabler:hexagons',
        callToAction: { text: 'View category', href: '/products/zeolite-molecular-sieve/' },
      },
      {
        title: 'Activated Carbon',
        description: 'Gas-phase adsorption, solvent recovery and odor control — honeycomb, columnar, coconut shell, fiber.',
        icon: 'tabler:layers-linked',
        callToAction: { text: 'View category', href: '/products/activated-carbon/' },
      },
      {
        title: 'Heating Components',
        description: 'Heating elements for catalytic oxidation and desorption systems.',
        icon: 'tabler:temperature',
        callToAction: { text: 'View page', href: '/products/heating-tubes/' },
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Ask for Material Selection', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Not sure which material <span class="text-accent">fits your gas conditions?</span>
    </Fragment>
    <Fragment slot="subtitle">
      Send us your flow rate, concentration, temperature and composition — we will recommend the right product family.
    </Fragment>
  </CallToAction>
</Layout>
