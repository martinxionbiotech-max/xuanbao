---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import realProductPhotos from '~/assets/images/products/real-product-photos.jpg';

const metadata = {
  title: 'Industrial Catalysts & Activated Carbon Products | Xuanbao Environmental',
  description:
    'Product catalog: precious-metal honeycomb ceramic VOC catalysts (YC-XB-A/B/C), SCR DeNOx catalysts, CO oxidation catalysts, activated carbon (coconut shell, coal-based columnar, honeycomb, fruit-shell, fiber) and zeolite molecular sieves.',
  ignoreTitleTemplate: true,
};

const groups = [
  {
    heading: 'Catalysts',
    intro:
      'Core product line: precious-metal honeycomb ceramic catalysts for VOC catalytic oxidation, plus SCR DeNOx and CO oxidation catalysts for industrial emission control.',
    icon: 'tabler:atom',
    items: [
      { name: 'VOC Oxidation Catalysts', note: 'Pt (YC-XB-A), Pt-Pd (YC-XB-B) and non-precious-metal (YC-XB-C) honeycomb ceramic catalysts.', href: '/products/voc-catalysts/' },
      { name: 'SCR DeNOx Catalysts', note: 'Plate-type and honeycomb V-Mo-Ti systems for NOx removal.', href: '/products/scr-denox-catalysts/' },
      { name: 'CO Oxidation Catalysts', note: 'Cordierite honeycomb / alumina catalysts for CO → CO₂.', href: '/products/co-removal-catalyst/' },
    ],
  },
  {
    heading: 'Activated Carbon',
    intro:
      'Carbon adsorbents for gas-phase adsorption, solvent vapor control, odor control and purification — available by raw material and by form.',
    icon: 'tabler:layers-linked',
    items: [
      { name: 'Coconut Shell Activated Carbon', note: 'High hardness, low ash, microporous structure.', href: '/products/activated-carbon/coconut-shell-carbon/' },
      { name: 'Coal-Based Columnar Activated Carbon', note: '1.5 / 4 / 6 / 8 mm diameters for gas purification and packed beds.', href: '/products/activated-carbon/coal-based-columnar-carbon/' },
      { name: 'Honeycomb Activated Carbon', note: 'Low pressure drop, structured contact surface.', href: '/products/activated-carbon/honeycomb-activated-carbon/' },
      { name: 'Fruit-Shell Activated Carbon', note: 'STK/SXK granular carbon for decolorization and water purification.', href: '/products/activated-carbon/fruit-shell-carbon/' },
      { name: 'Activated Carbon Fiber', note: 'Low-concentration gas-phase pollutants and odor control.', href: '/products/activated-carbon/activated-carbon-fiber/' },
    ],
  },
  {
    heading: 'Molecular Sieves',
    intro:
      'Zeolite molecular sieves for selective adsorption, drying, separation and VOC adsorption concentration.',
    icon: 'tabler:hexagons',
    items: [
      { name: 'Modified 5A Molecular Sieve', note: 'Selective adsorption, drying and gas separation.', href: '/products/zeolite-molecular-sieve/modified-5a/' },
      { name: 'Modified 13X Molecular Sieve', note: 'Large-pore sodium X-type zeolite for drying and CO₂ adsorption.', href: '/products/zeolite-molecular-sieve/modified-13x/' },
      { name: 'ZSM-5 Molecular Sieve', note: 'High-silica, hydrophobic — core adsorbent for VOC concentration systems.', href: '/products/zeolite-molecular-sieve/zsm-5/' },
      { name: 'NaY Molecular Sieve', note: 'High surface area for VOC adsorption and catalyst support.', href: '/products/zeolite-molecular-sieve/nay/' },
    ],
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    badge="Products"
    title="Industrial Catalysts & Activated Carbon Products"
    subtitle="Xuanbao specializes in precious-metal honeycomb ceramic catalysts for VOC catalytic oxidation, alongside SCR / CO catalysts, activated carbon and zeolite molecular sieves for gas treatment, purification and industrial process applications."
  />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 pb-8 space-y-14">
    {
      groups.map((group) => (
        <section>
          <div class="mb-6 flex flex-col items-center gap-3 text-center">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-black">
              <Icon name={group.icon} class="h-5 w-5" />
            </span>
            <div class="flex flex-col items-center">
              <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading">{group.heading}</h2>
              <p class="text-muted mt-1 max-w-3xl">{group.intro}</p>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              group.items.map((item) => (
                <a
                  href={item.href}
                  class="group rounded-xl border border-slate-700/60 bg-slate-900/40 p-5 transition hover:border-primary hover:bg-slate-900/70"
                >
                  <h3 class="font-semibold text-heading group-hover:text-primary">{item.name}</h3>
                  <p class="mt-2 text-sm text-muted leading-relaxed">{item.note}</p>
                  <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary">
                    View details <Icon name="tabler:arrow-right" class="h-4 w-4" />
                  </span>
                </a>
              ))
            }
          </div>
        </section>
      ))
    }
  </div>

  <section class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Real Product Photos</h2>
    <figure class="rounded-xl border border-slate-800 bg-slate-900/40 p-2">
      <Image
        src={realProductPhotos}
        alt="Real product photos from Xuanbao Environmental — activated carbon and industrial catalyst products"
        class="w-full h-auto rounded-lg"
        width={1600}
      />
      <figcaption class="px-2 py-2 text-sm text-muted text-center">
        Real product photos — Xuanbao Environmental
      </figcaption>
    </figure>
  </section>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Ask for Material Selection', href: '/contact/', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">
      Not sure which material <span class="text-accent">fits your conditions?</span>
    </Fragment>
    <Fragment slot="subtitle">
      Send us your flow rate, concentration, temperature and composition — we will recommend the right material system.
    </Fragment>
  </CallToAction>
</Layout>
