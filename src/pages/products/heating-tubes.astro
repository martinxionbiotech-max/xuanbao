---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Heating Components for Catalytic Systems',
  description:
    'Heating elements and components supporting catalytic oxidation and adsorption-desorption systems for industrial emission control.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Products', href: '/products/' }, { text: 'Heating Components' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">Products</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      Heating Components
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">
      Heating elements that support catalytic oxidation and adsorption-desorption systems.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Overview</h2>
      <p class="text-muted leading-relaxed">
        Catalytic oxidation and adsorption-concentration systems require controlled preheating and desorption
        heating. We supply heating components matched to the system design, including the temperature and power
        requirements of the catalyst bed or desorption stage.
      </p>
    </section>

    <Features
      title="Applications"
      columns={3}
      items={[
        { title: 'Preheating', description: 'Preheating of VOC streams before catalytic oxidation.', icon: 'tabler:flame' },
        { title: 'Desorption', description: 'Desorption heating in zeolite adsorption concentration systems.', icon: 'tabler:temperature' },
        { title: 'Heat recovery', description: 'Heat recovery loop components.', icon: 'tabler:recycle' },
      ]}
    />

    <section class="rounded-xl border border-primary/30 bg-primary/10 p-5 text-muted leading-relaxed">
      <strong class="text-heading">Specifications</strong>
      <span class="block mt-2">
        Heating component specifications are confirmed per project against flow rate, temperature requirement and
        power supply. Please share your system parameters for a quotation.
      </span>
    </section>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'Request a Quotation', href: '/contact/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Share your <span class="text-accent">system parameters</span>
    </Fragment>
    <Fragment slot="subtitle">
      Flow rate, target temperature and power supply — we will propose matched heating components.
    </Fragment>
  </CallToAction>
</Layout>
