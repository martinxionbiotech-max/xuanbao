---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';

import heatingTubesPhoto from '~/assets/images/products/finned-heating-tubes.jpg';
import heatingTubesSpec from '~/assets/images/products/finned-heating-tubes-specification-sheet.png';
import heatingTubeDrawing from '~/assets/images/products/finned-heating-tube-drawing.png';

const metadata = {
  title: 'Heating Components for Catalytic Systems',
  description:
    'Heating elements and components supporting catalytic oxidation and adsorption-desorption systems for industrial emission control.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Products', href: '/products/' }, { text: 'Heating Components' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Products</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Heating Components
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Heating elements that support catalytic oxidation and adsorption-desorption systems.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-2">
    <div class="grid gap-6 md:grid-cols-2 items-start">
      <figure class="rounded-xl border border-slate-800 bg-slate-900/40 p-2">
        <Image src={heatingTubesPhoto} alt="Finned U-type electric heating tubes product photo — 220 V 500 W to 380 V 6 kW for VOC catalytic oxidation preheating" class="w-full h-auto rounded-lg" width={704} />
        <figcaption class="px-2 py-2 text-sm text-muted">Product photo — Xuanbao Environmental</figcaption>
      </figure>
      <figure class="rounded-xl border border-slate-800 bg-white p-2">
        <Image src={heatingTubesSpec} alt="Finned heating tubes specification sheet — voltage and power ratings from 220 V 500 W to 380 V 6 kW, design service life 5,000+ hours" class="w-full h-auto rounded-lg" width={840} />
      </figure>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-2">
    <figure class="rounded-xl border border-slate-800 bg-white p-2">
      <Image
        src={heatingTubeDrawing}
        alt="Finned U-type electric heating tube dimensional drawing — thread 18 mm / 22 mm, tube diameter 12 mm / 16 mm, heated length 300 mm / 950 mm, center distance 55 mm, iron or stainless steel"
        class="w-full h-auto rounded-lg"
        width={840}
      />
      <figcaption class="px-2 py-2 text-sm text-muted">
        Dimensional drawing (schematic, not to scale) based on the company brochure.
      </figcaption>
    </figure>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Overview</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        Catalytic oxidation and adsorption-concentration systems require controlled preheating and desorption
        heating. We supply heating components matched to the system design, including the temperature and power
        requirements of the catalyst bed or desorption stage.
      </p>
    </section>

    <Features
      title="Applications"
      columns={3}
      items={[
        { title: 'Preheating', description: 'Preheating of VOC streams before catalytic oxidation.', icon: 'tabler:flame' },
        { title: 'Desorption', description: 'Desorption heating in zeolite adsorption concentration systems.', icon: 'tabler:temperature' },
        { title: 'Heat recovery', description: 'Heat recovery loop components.', icon: 'tabler:recycle' },
      ]}
    />

    <section class="rounded-xl border border-primary/30 bg-primary/10 p-5 text-muted leading-relaxed">
      <strong class="text-heading">Specifications</strong>
      <span class="block mt-2">
        Standard configurations per manufacturer brochure include finned/U-type electric heating tubes from
        220 V 500 W to 380 V 6 kW (tube Ø 12/16 mm, thread 18/22 mm, length 30–98 cm, iron or stainless-steel body,
        design life 5,000+ hours). Final configuration is confirmed per project against flow rate, temperature
        requirement and power supply. Please share your system parameters for a quotation.
      </span>
    </section>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'Request a Quotation', href: '/contact/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Share your <span class="text-accent">system parameters</span>
    </Fragment>
    <Fragment slot="subtitle">
      Flow rate, target temperature and power supply — we will propose matched heating components.
    </Fragment>
  </CallToAction>
</Layout>
