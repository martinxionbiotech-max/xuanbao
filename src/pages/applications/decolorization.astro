---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Decolorization with Activated Carbon: Food, Sugar & Chemical Liquids',
  description:
    'Activated carbon decolorization for food, sugar and chemical liquids: color-body removal by adsorption — powdered contact process vs granular bed, selection and quality indicators.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Applications', href: '/applications/' }, { text: 'Decolorization' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Applications</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Decolorization with Activated Carbon
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Color bodies removed from liquids by adsorption — sugar syrup, food and beverage, and chemical process liquids.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-12">
    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">What decolorization is</h2>
      <p class="text-muted leading-relaxed max-w-3xl mx-auto text-center">
        Decolorization removes dissolved color bodies from a liquid stream. The colorants are large organic
        molecules — melanoidins and caramels in sugar processing, natural pigments in juices and extracts, and
        oxidized byproducts in chemical and pharmaceutical intermediates. Activated carbon adsorbs them onto its
        pore surface; the wide pore distribution of decolorizing grades is deliberately sized to accept these
        larger molecules, which distinguishes the duty from small-molecule purification.
      </p>
      <ul class="space-y-3 text-muted mt-4 max-w-3xl mx-auto">
        <li><strong class="text-heading">Contact process</strong> — powdered carbon mixed into the hot liquid, held for the required contact time, then filtered out. The standard route for sugar refining and batch decolorization.</li>
        <li><strong class="text-heading">Bed process</strong> — granular carbon in a fixed column through which the liquid passes continuously, with thermal reactivation of the spent carbon.</li>
      </ul>
      <p class="text-muted mt-4 text-sm max-w-3xl mx-auto text-center">
        The decolorization indicator on a certificate is the methylene blue adsorption value — a proxy for the
        carbon's capacity toward colored organics. Background:{' '}
        <a class="text-primary hover:underline" href="https://data.xuanbaoenvironment.com/activated-carbon/activated-carbon-ctc-methylene-blue/">CTC &amp; methylene blue indicators</a> in our knowledge center.
      </p>
    </section>

    <Features
      columns={3}
      title="Material routes"
      items={[
        { title: 'Powdered decolorizing grades', description: 'Contact-process dosing for sugar syrup, food liquids and batch chemical decolorization.', icon: 'tabler:grain', callToAction: { text: 'Activated carbon products', href: '/products/activated-carbon/' } },
        { title: 'Coal-based granular', description: 'Fixed-bed decolorization and general liquid duty with reactivation economics.', icon: 'tabler:stack-2', callToAction: { text: 'Coal-based columnar carbon', href: '/products/activated-carbon/coal-based-columnar-carbon/' } },
        { title: 'Fruit-shell grades', description: 'STK/SXK granular fruit-shell carbon — documented duty: sugar, wine, MSG, amino-acid, beverage and drinking-water decolorization.', icon: 'tabler:droplet-off', callToAction: { text: 'Fruit-shell carbon', href: '/products/activated-carbon/fruit-shell-carbon/' } },
      ]}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4 text-center">Selection checklist</h2>
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40 p-1"><table class="w-full text-sm md:text-base"><tbody><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">The liquid</td><td class="px-3 py-2 align-top text-muted">what it is, its temperature at the contact point, and its viscosity. Hot syrup contacts differently than cold water.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">The colorant</td><td class="px-3 py-2 align-top text-muted">the target color value and its test method (ICUMSA for sugar, APHA/Hazen elsewhere); decolorization duty is specified by the residual color, not "removal percentage" alone.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">The contact mode</td><td class="px-3 py-2 align-top text-muted">batch contact with powder, or continuous bed. The two use different grades and different economics.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">The purity constraints</td><td class="px-3 py-2 align-top text-muted">for food and beverage duty, state ash, heavy-metal and odor requirements; the grade must match the end-use standard.</td></tr><tr class="border-b border-slate-800 last:border-0"><td class="px-3 py-2 align-top font-semibold text-heading whitespace-nowrap">The filter step</td><td class="px-3 py-2 align-top text-muted">powder must be separated afterward; plan the filtration stage together with the carbon dose.</td></tr></tbody></table></div>
      <p class="text-muted mt-4 text-sm max-w-3xl mx-auto text-center">
        Technical background:{' '}
        <a class="text-primary hover:underline" href="https://data.xuanbaoenvironment.com/activated-carbon/activated-carbon-quality-indicators/">activated carbon quality indicators</a>{' '}
        and{' '}
        <a class="text-primary hover:underline" href="https://data.xuanbaoenvironment.com/activated-carbon/activated-carbon-regeneration/">regeneration</a> in our knowledge center.
      </p>
    </section>
  </div>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Describe Your Liquid and Color Target', href: '/contact/', icon: 'tabler:arrow-right' }, { variant: 'whatsapp', text: 'Chat on WhatsApp', href: 'https://wa.me/8615153588090', icon: 'tabler:brand-whatsapp', target: '_blank' }]}
  >
    <Fragment slot="title">
      Name the liquid, <span class="text-accent">we match the decolorizing grade</span>
    </Fragment>
    <Fragment slot="subtitle">
      Liquid, temperature, contact mode and target color value — the four inputs of a decolorization spec.
    </Fragment>
  </CallToAction>
</Layout>
