---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Resources & Knowledge Center',
  description:
    'Technical resources for industrial emission control — visit our Knowledge Center for SCR, CO oxidation, VOC catalyst, molecular sieve and activated carbon technical guides.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Resources' }]} />

  <section class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2">Resources</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">
      Resources
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">
      Technical documentation, guides and the Industrial Emission Control Knowledge Center.
    </p>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 pb-6 md:pb-10 space-y-10">
    <section class="rounded-xl border border-primary/30 bg-primary/10 p-5 md:p-6">
      <strong class="text-heading">📚 Industrial Emission Control Knowledge Center</strong>
      <p class="mt-2 text-muted leading-relaxed">
        Deep technical content — SCR fundamentals, CO oxidation, VOC catalysis, molecular sieve and activated carbon
        data, adsorption engineering and catalyst selection guides — is published in our knowledge center at{' '}
        <a class="font-semibold text-primary hover:underline" href="https://data.xuanbaoenvironment.com">
          data.xuanbaoenvironment.com
        </a>.
      </p>
    </section>

    <Features
      columns={3}
      title="What you will find there"
      items={[
        { title: 'SCR DeNOx', description: 'What is SCR, plate vs honeycomb, poisoning, regeneration, replacement.', icon: 'tabler:wind' },
        { title: 'CO Oxidation', description: 'Fundamentals, light-off temperature, SO₂ and water effects, service life.', icon: 'tabler:flame' },
        { title: 'VOC Catalysts', description: 'Catalytic oxidation, T50/T90, space velocity, Pt / Pd / non-precious-metal systems.', icon: 'tabler:atom' },
        { title: 'Molecular Sieves', description: '5A / 13X / NaY / ZSM-5, pore structure, selectivity, regeneration.', icon: 'tabler:hexagons' },
        { title: 'Activated Carbon', description: 'Iodine value, CCl₄ adsorption, fire safety, regeneration, replacement.', icon: 'tabler:layers-linked' },
        { title: 'VOC Engineering', description: 'Concentration, LEL, humidity, pressure drop, heat recovery.', icon: 'tabler:settings' },
      ]}
    />

    <section>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading mb-4">Data you can request</h2>
      <ul class="grid gap-2 sm:grid-cols-3 text-muted">
        <li>Product data sheets and specifications</li>
        <li>Testing documentation</li>
        <li>Case study operating data</li>
      </ul>
    </section>
  </div>

  <CallToAction actions={[{ variant: 'primary', text: 'Request Documentation', href: '/contact/', icon: 'tabler:arrow-right' }]}>
    <Fragment slot="title">
      Need the <span class="text-accent">data sheets?</span>
    </Fragment>
    <Fragment slot="subtitle">
      Product specifications, testing documentation and case study operating data are available on request.
    </Fragment>
  </CallToAction>
</Layout>
